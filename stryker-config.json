{
  "stryker-config": {
    "project": "Tempest.Core.csproj",
    "test-projects": [
      "tests/Tempest.Core.Tests/Tempest.Core.Tests.csproj"
    ],
    "mutate": [
      "Calculations/**/*.cs",
      "UnitsAndQuantities/**/*.cs"
    ],
