<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      WP 10.0B: Avalonia's own headless rendering backend
      (Avalonia.Headless.XUnit) runs and interacts with real Tempest.Desktop
      controls with no real display attached — the disclosed new test
      strategy ADR-0094 named (WP10.0A Architecture Review.md §5, Risk 2),
      letting this Work Package's own "Demonstrate" requirements be proven
      as real, dotnet-test-verified behaviour rather than asserted prose.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.20" />
    <!--
      WP 16.4A (part 2), TD-100: a real Skia rendering subsystem for the
      headless test host, so Avalonia.Media.Imaging.Bitmap decodes real
      image bytes instead of the headless platform's stub decoder (which
      reports every image as 1x1 regardless of its actual content).
      Pinned to the same version as Avalonia.Headless.XUnit above.
    -->
    <PackageReference Include="Avalonia.Skia" Version="11.3.20" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tempest.Core\Tempest.Core.csproj" />
    <ProjectReference Include="..\..\src\Samples\Tempest.Samples\Tempest.Samples.csproj" />
    <ProjectReference Include="..\..\src\Tempest.Workspace\Tempest.Workspace.csproj" />
    <ProjectReference Include="..\..\src\Tempest.Desktop\Tempest.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      v0.24.0 U2 (Xero Technical Design §10.1, §11): the in-process Xero API
      simulator S1 owns, compiled into this project too (linked, not copied)
      so Desktop tests drive real views end to end through the real Xero
      client and safety handler with no network. Its own self-tests stay in
      Tempest.Core.Tests.
    -->
    <Compile Include="..\Tempest.Core.Tests\Invoicing\Xero\Simulator\XeroApiSimulator*.cs;..\Tempest.Core.Tests\Invoicing\Xero\Simulator\XeroSimulatorClock.cs;..\Tempest.Core.Tests\Invoicing\Xero\Simulator\SimulatorSeed.UkDemo.cs"
             Exclude="..\Tempest.Core.Tests\Invoicing\Xero\Simulator\*Tests.cs"
             Link="Xero\Simulator\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
