<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tempest.Core\Tempest.Core.csproj" />
    <ProjectReference Include="..\..\src\Samples\Tempest.Samples\Tempest.Samples.csproj" />
    <ProjectReference Include="..\..\src\Tempest.App\Tempest.App.csproj" />
    <ProjectReference Include="..\..\src\Validation\Tempest.Validation\Tempest.Validation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TD-87/ADR-0120: the golden corpus of pre-`WP 16.3B` state records —
         the exact byte-for-byte shape `v1` ever produced — plain files
         next to the test binaries at run time, read the same way every
         other test in this suite reads its own inputs (no embedded-resource
         indirection). -->
    <None Include="EngineeringDomain/SchemaVersioning/GoldenCorpus/**/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>