{"nodes": [{"id": "docs_adr_adr_0149_a_reference_record_carries_a_structured_source_citation_and_supersession_keeps_every_pin_valid_adr_0149", "label": "ADR-0149", "file_type": "document", "source_file": "docs/adr/ADR-0149-a-reference-record-carries-a-structured-source-citation-and-supersession-keeps-every-pin-valid.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A reference record carries an optional structured SourceCitation persisted beside Definition/Provenance; ReviseAsync's pre-existing overload carries the current citation forward; the supersession invariant (every pin ever minted still resolves) is a tested CsCheck property over all five libraries. Re-scoped from interpolation/value bands, which D-028 withdrew."}, {"id": "docs_adr_adr_0149_a_reference_record_carries_a_structured_source_citation_and_supersession_keeps_every_pin_valid_sourcecitation", "label": "SourceCitation", "file_type": "code", "source_file": "docs/adr/ADR-0149-a-reference-record-carries-a-structured-source-citation-and-supersession-keeps-every-pin-valid.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Publisher/Work required, Edition/Page/TableOrFigure/RowOrEntry null where unstated, never guessed; ToString is one issue-sheet line."}, {"id": "docs_adr_adr_0149_a_reference_record_carries_a_structured_source_citation_and_supersession_keeps_every_pin_valid_referenceprovenance", "label": "ReferenceProvenance", "file_type": "code", "source_file": "docs/adr/ADR-0149-a-reference-record-carries-a-structured-source-citation-and-supersession-keeps-every-pin-valid.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ADR-0124's free-text SourceOrganisation/SourceDocument/SourceLocation \u2014 answers a different question from SourceCitation, so neither is derived from the other."}, {"id": "docs_adr_adr_0149_a_reference_record_carries_a_structured_source_citation_and_supersession_keeps_every_pin_valid_supersession_invariant", "label": "Supersession Invariant", "file_type": "rationale", "source_file": "docs/adr/ADR-0149-a-reference-record-carries-a-structured-source-citation-and-supersession-keeps-every-pin-valid.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing is deleted or overwritten across revise, lifecycle move or supersede; a random-sequence CsCheck property asserts every ReferencePin still resolves to its exact content and a superseded record still reports Superseded via FindAsync."}, {"id": "docs_adr_adr_0149_a_reference_record_carries_a_structured_source_citation_and_supersession_keeps_every_pin_valid_ireferencedatacatalog", "label": "IReferenceDataCatalog<T>", "file_type": "code", "source_file": "docs/adr/ADR-0149-a-reference-record-carries-a-structured-source-citation-and-supersession-keeps-every-pin-valid.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gains citation-accepting RegisterAsync/ReviseAsync overloads; the pre-existing overloads' signatures and callers are unchanged."}, {"id": "docs_adr_adr_0149_a_reference_record_carries_a_structured_source_citation_and_supersession_keeps_every_pin_valid_two_revision_numbers", "label": "Two Revision Numbers (Amendment)", "file_type": "rationale", "source_file": "docs/adr/ADR-0149-a-reference-record-carries-a-structured-source-citation-and-supersession-keeps-every-pin-valid.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ADR-0159: RevisionNumber is the stored version stamp pins cite and advances on every write; ContentRevision is what a person sees and advances only when definition, citation or source identity changes."}, {"id": "docs_adr_adr_0149_a_reference_record_carries_a_structured_source_citation_and_supersession_keeps_every_pin_valid_referencepin", "label": "ReferencePin", "file_type": "code", "source_file": "docs/adr/ADR-0149-a-reference-record-carries-a-structured-source-citation-and-supersession-keeps-every-pin-valid.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pins the exact stored revision (RevisionNumber) of a reference record; no single typed handle spans the five governed catalogues."}, {"id": "docs_adr_adr_0149_a_reference_record_carries_a_structured_source_citation_and_supersession_keeps_every_pin_valid_forty_one_seeded_citations", "label": "Forty-One Seeded Records With Citation", "file_type": "concept", "source_file": "docs/adr/ADR-0149-a-reference-record-carries-a-structured-source-citation-and-supersession-keeps-every-pin-valid.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only records whose dataset already named a publisher and work; no citation is invented past what the source stated."}], "edges": [{"source": "docs_adr_adr_0149_a_reference_record_carries_a_structured_source_citation_and_supersession_keeps_every_pin_valid_adr_0149", "target": "docs_governance_architecture_adr_register_adr_0124", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-0149-a-reference-record-carries-a-structured-source-citation-and-supersession-keeps-every-pin-valid.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_0149_a_reference_record_carries_a_structured_source_citation_and_supersession_keeps_every_pin_valid_adr_0149", "target": "docs_governance_architecture_adr_register_adr_0143", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-0149-a-reference-record-carries-a-structured-source-citation-and-supersession-keeps-every-pin-valid.md", "source_location": nul