{"nodes": [{"id": "docs_adr_adr_0157_the_review_queue_is_exported_read_only_as_reviews_json_adr_0157", "label": "ADR-0157", "file_type": "document", "source_file": "docs/adr/ADR-0157-the-review-queue-is-exported-read-only-as-reviews-json.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The lost Companion app's read-only review queue returns as a fifth Dashboard Export file, reviews.json (schema v1), listing every live item awaiting review across Documents/Drawings/CAD Models, Calculations, Verification Activities, Evidence and Requirements in each family's own words, oldest first \u2014 with no approve, reject or status-change path."}, {"id": "docs_adr_adr_0157_the_review_queue_is_exported_read_only_as_reviews_json_reviews_json", "label": "reviews.json", "file_type": "concept", "source_file": "docs/adr/ADR-0157-the-review-queue-is-exported-read-only-as-reviews-json.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Its own file, schema and ingest source because the queue is a list of records with its own consumers (the Engineering view's list, Home's attention count), while engineering-status.json is counts and Cockpit surfaces."}, {"id": "docs_adr_adr_0157_the_review_queue_is_exported_read_only_as_reviews_json_reviewqueueexportadapter", "label": "ReviewQueueExportAdapter", "file_type": "code", "source_file": "docs/adr/ADR-0157-the-review-queue-is-exported-read-only-as-reviews-json.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_0157_the_review_queue_is_exported_read_only_as_reviews_json_dashboardexporthostedservice", "label": "DashboardExportHostedService", "file_type": "code", "source_file": "docs/adr/ADR-0157-the-review-queue-is-exported-read-only-as-reviews-json.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writes reviews.json on the same tick and the same atomic .tmp rename as the other four files."}, {"id": "docs_adr_adr_0157_the_review_queue_is_exported_read_only_as_reviews_json_awaiting_review_per_family", "label": "Awaiting Review Is Each Family's Own InReview Equivalent", "file_type": "rationale", "source_file": "docs/adr/ADR-0157-the-review-queue-is-exported-read-only-as-reviews-json.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lifecycle Kinds: InReview dated by the last transition; Evidence: Checked with a non-rejected check; Requirements: Reviewed, dated by creation (sinceBasis created) with submittedBy null because no status-change time or actor is recorded \u2014 disclosed rather than guessed."}, {"id": "docs_adr_adr_0157_the_review_queue_is_exported_read_only_as_reviews_json_companion_app", "label": "Companion App (lost, August 2026)", "file_type": "concept", "source_file": "docs/adr/ADR-0157-the-review-queue-is-exported-read-only-as-reviews-json.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recovered ref refs/recovered/claude/tempestos-companion-mobile-ubznt3; listed pending reviews via CompanionQueryService.BuildPendingReviewsAsync and had a write action that is not wanted."}, {"id": "docs_adr_adr_0157_the_review_queue_is_exported_read_only_as_reviews_json_read_only_review_queue", "label": "Read-Only, No Write Path", "file_type": "rationale", "source_file": "docs/adr/ADR-0157-the-review-queue-is-exported-read-only-as-reviews-json.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No approve, reject or status-change from the dashboard or the phone."}, {"id": "docs_adr_adr_0157_the_review_queue_is_exported_read_only_as_reviews_json_index_filters_only_queued_materialised", "label": "The Index Filters; Only Queued Items Are Materialised", "file_type": "rationale", "source_file": "docs/adr/ADR-0157-the-review-queue-is-exported-read-only-as-reviews-json.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repository lists are index rows (TD-88, WP 21.5B): liveness and InReview are read from the row; Evidence keeps its own status beside the canonical one so live Evidence is materialised as engineering-status.json already does."}], "edges": [{"source": "docs_adr_adr_0157_the_review_queue_is_exported_read_only_as_reviews_json_adr_0157", "target": "docs_adr_adr_0148_evidence_is_a_canonical_kind_specialising_the_lifecycle_and_citing_governed_reference_data_adr_0148", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-0157-the-review-queue-is-exported-read-only-as-reviews-json.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_0157_the_review_queue_is_exported_read_only_as_reviews_json_adr_0157", "target": "docs_adr_adr_0154_contracts_and_quotations_return_to_the_build_and_a_sales_quotation_is_a_governed_record_adr_0154", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-0157-the-review-queue-is-exported-read-only-as-reviews-json.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_0157_the_review_queue_is_exported_read_only_as_reviews_json_adr_0157", "target": "docs_adr_adr_0155_project_health_is_the_engineering_cockpit_s_health_rollup_scoped_to_a_project_adr_0155", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-0157-the-review-queue-is-exported-read-only-as-reviews-json.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_0157_the_review_queue_is_exported_read_only_as_reviews_json_awaiting_review_per_family", "target": "docs_adr_adr_0157_the_review_queue_is_exported_read_only_as_reviews