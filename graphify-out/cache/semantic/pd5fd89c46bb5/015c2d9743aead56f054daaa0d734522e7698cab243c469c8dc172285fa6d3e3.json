my_adr_0141", "label": "ADR-0141", "file_type": "concept", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_not_the_repository_docs_academy", "label": "Not the Repository docs/academy", "file_type": "rationale", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "docs/academy is developer documentation about TempestOS; P06 is a structure for teaching engineering held in the platform for its users; the two never meet."}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_knowledgeprovenance", "label": "KnowledgeProvenance", "file_type": "rationale", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three orthogonal axes: KnowledgeOrigin, KnowledgeReviewState, ReferenceValidationState; a Released Validated record of Authored content nobody reviewed is a real situation needing all three."}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_knowledgeorigin", "label": "KnowledgeOrigin", "file_type": "concept", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_knowledgereviewstate", "label": "KnowledgeReviewState", "file_type": "concept", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_isauthoritative_derived", "label": "IsAuthoritative Derived", "file_type": "rationale", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires an origin that can bear authority, a competent review and a findable citation for external content; FictionalFixture and Unspecified can never bear authority."}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_machinegenerated_origin", "label": "MachineGenerated Origin", "file_type": "rationale", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Its own origin; unreviewed generated content is a validation error because generated content is raw material and a person review is what makes it knowledge, after which it is authoritative like anything else."}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_fictionalfixture", "label": "FictionalFixture", "file_type": "rationale", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A reviewed fiction is still a fiction; registering fictional content in any library is a validation error."}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_citations_must_be_findable", "label": "Citations Must Be Findable", "file_type": "rationale", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A title and author are not enough: editions differ and a value from the wrong edition is a wrong value."}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_knowledgeapplicability", "label": "KnowledgeApplicability", "file_type": "rationale", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reuses P05 EngineeringDiscipline rather than a second vocabulary; a reader at Intermediate is offered introductory material too and never specialist material."}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_p06_validation_prefixes", "label": "P06 Validation Prefixes", "file_type": "rationale", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TEMPEST-KNP, KNA, KNC, KNL, KNW over the shared KNG-001 to 016."}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_knowledgeprompts", "label": "KnowledgePrompts", "file_type": "concept", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_knowledgeacademy", "label": "KnowledgeAcademy", "file_type": "concept", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_knowledgechallenges", "label": "KnowledgeChallenges", "file_type": "concept", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_knowledgelessons", "label": "KnowledgeLessons", "file_type": "concept", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_knowledgeworkedexamples", "label": "KnowledgeWorkedExamples", "file_type": "concept", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_humanreviewguidance_required", "label": "HumanReviewGuidance Required", "file_type": "rationale", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every prompt in an engineering context produces something somebody must check; one that does not say what checking looks like is an invitation to skip it, and a prompt asking for approval or sign-off is reported."}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_academynode", "label": "AcademyNode", "file_type": "rationale", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One recursive node with a kind (subject, discipline, module, lesson, concept) because these are one concept at five depths; CanContain enforces strict narrowing; parent references not nesting; FindPathToAsync stops at a cycle."}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_learningoutcome", "label": "LearningOutcome", "file_type": "rationale", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A statement about the learner, not coverage, because only the first can be assessed; an outcome nothing assesses is a promise nobody checks."}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_reasoningarea", "label": "ReasoningArea", "file_type": "rationale", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guidance for a human marker rather than an answer key, because an open design challenge has no single right answer."}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_deliberateomissions", "label": "DeliberateOmissions", "file_type": "rationale", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Its own field because what a challenge withholds is often the whole point."}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_causeconfidence", "label": "CauseConfidence", "file_type": "rationale", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NotInvestigated, Suspected, Probable, Established: most failures are never fully investigated and recording every plausible story as root cause teaches wrong lessons confidently."}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_isverifiedeffective", "label": "IsVerifiedEffective", "file_type": "rationale", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implemented and effective are different things and the gap is where organisations learn nothing twice; requires evidence, not a state."}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_shareable_lesson_without_parties", "label": "Shareable Lesson Without Parties", "file_type": "rationale", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A shareable lesson whose text names a customer, supplier or company is flagged; it should carry the learning without the parties."}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_reasoning_is_the_content", "label": "Reasoning Is the Content", "file_type": "rationale", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every worked step carries Reasoning separate from its working because a reader can follow arithmetic without learning anything; IsInstructive requires no unexplained step."}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_workedvalue_unit_field", "label": "WorkedValue Unit Field", "file_type": "rationale", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A quantity with no unit and no explicit dimensionless flag is an error: unit mistakes are the commonest way a calculation goes wrong."}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_p06_libraries_ship_empty", "label": "P06 Libraries Ship Empty", "file_type": "rationale", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seeding the Academy would put platform-written instruction before learners with built-in authority; seeding lessons would present invented stories as organisational memory; both are worse than an empty library."}, {"id": "docs_architecture_group_f_ai_knowledge_and_academy_nothing_depends_on_p06", "label": "Nothing Depends on P06", "file_type": "concept", "source_file": "docs/architecture/Group F AI Knowledge and Academy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "