{"nodes": [{"id": "_github_workflows_release_release_publish", "label": "Release Publish Workflow (release.yml)", "file_type": "code", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Triggered only by a v*.*.* tag; re-builds and re-tests Release at the exact tagged commit so a release is never published on an earlier feature-branch CI run. Every tagged release gets a durable non-expiring downloadable build as the rollback procedure's mechanical foundation."}, {"id": "_github_workflows_release_ci_gate_wait", "label": "ci-gate job (wait for CI Gate check run on the tagged commit)", "file_type": "code", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_release_build", "label": "build job (Build, Test & Package Release)", "file_type": "code", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs restore, build, test, governance check and vpk (third-party code) with a read-only token not persisted in .git/config (ADR-0160 G-05)."}, {"id": "_github_workflows_release_publish", "label": "publish job (Publish GitHub Release)", "file_type": "code", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only job with contents: write; checks out nothing and runs no repository code \u2014 downloads the artifact, verifies SHA256SUMS.txt, creates the release with preinstalled gh (no third-party release action)."}, {"id": "_github_workflows_release_wp_11_1b", "label": "WP 11.1B \u2014 Version-Tagging Workflow & Rollback Support", "file_type": "concept", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_release_wp_21_5a", "label": "WP 21.5A / WP RC.0A \u2014 Velopack-packaged Windows installer (TempestOS-<tag>-Setup.exe)", "file_type": "concept", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built by the exact script a developer runs locally (package-installer.ps1), so no act-style GitHub-Actions-in-a-container tool is needed. Additive: dotnet run and the plain zips are unaffected."}, {"id": "_github_workflows_release_tag_is_never_moved", "label": "A pushed tag is never moved or recreated (Engineering Governance \u00a77.4)", "file_type": "rationale", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A tagged commit that fails re-verification is not published; the corrective action is a new patch version and new tag. Failed release runs can be re-run once the cause is fixed."}, {"id": "_github_workflows_release_sha256sums", "label": "SHA256SUMS.txt \u2014 published checksums over every release asset", "file_type": "concept", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WP 21.5F OSA-10: no Authenticode code-signing exists yet, so a published SHA-256 is the only integrity check for downloaders. Computed after packaging and before publishing; LF line endings so sha256sum -c works as is."}, {"id": "_github_workflows_release_read_only_build_write_only_publish", "label": "Read-only build / write-only publish job split", "file_type": "rationale", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ADR-0160 G-05: restore, build, test and vpk never see a token that can write to the repository; publish runs no repository code."}, {"id": "_github_workflows_release_polling_checks_api_not_workflow_run", "label": "Poll the Checks API for CI Gate rather than a workflow_run trigger", "file_type": "rationale", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A workflow_run workflow runs the default-branch copy of release.yml, not the one at the tag, and carries the CI run's head branch rather than the tag. Polling keeps trigger, workflow file and commit all the tag's own and needs only checks: read."}, {"id": "_github_workflows_release_package_installer_script", "label": "scripts/package-installer.ps1", "file_type": "code", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_release_release_notes_convention", "label": "Release notes by directory convention (docs/releases/vX.Y.Z/Release Notes.md)", "file_type": "concept", "source_file": ".github/workflows/release.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An -rc. tag has no notes file yet, so it falls back to an honest generated placeholder rather than failing."}], "edges": [{"source": "_github_workflows_release_release_publish", "target": "_github_workflows_release_ci_gate_wait", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/release.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_release_release_publish", "target": "_github_workflows_release_build", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/release.yml", "source_location": null, "weight": 1.0}, 