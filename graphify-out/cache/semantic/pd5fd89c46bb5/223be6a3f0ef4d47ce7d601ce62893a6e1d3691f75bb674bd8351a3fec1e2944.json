{"nodes": [{"id": "docs_adr_adr_0106_release_sign_off_is_governed_by_a_permanent_five_category_engineering_readiness_review_adr_0106", "label": "ADR-0106", "file_type": "document", "source_file": "docs/adr/ADR-0106-release-sign-off-is-governed-by-a-permanent-five-category-engineering-readiness-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Release sign-off is a permanent five-category Engineering Readiness Review run by the six-discipline Programme Review against a fixed blocking taxonomy and four-value verdict vocabulary, replacing ad hoc per-release checklists; the Programme Review recommends, Product Approval alone decides."}, {"id": "docs_adr_adr_0106_release_sign_off_is_governed_by_a_permanent_five_category_engineering_readiness_review_engineering_readiness_review", "label": "Engineering Readiness Review", "file_type": "rationale", "source_file": "docs/adr/ADR-0106-release-sign-off-is-governed-by-a-permanent-five-category-engineering-readiness-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Formalises what two consecutive releases (WP 10.9A, WP 11.9.0) converged on unprompted; a single Not Ready category blocks Product Approval."}, {"id": "docs_adr_adr_0106_release_sign_off_is_governed_by_a_permanent_five_category_engineering_readiness_review_five_readiness_categories", "label": "Five Readiness Categories", "file_type": "concept", "source_file": "docs/adr/ADR-0106-release-sign-off-is-governed-by-a-permanent-five-category-engineering-readiness-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Architecture, Implementation, Verification, Governance, Release readiness \u2014 each independently reviewed with its own evidence and blocking conditions."}, {"id": "docs_adr_adr_0106_release_sign_off_is_governed_by_a_permanent_five_category_engineering_readiness_review_blocking_taxonomy", "label": "Blocking Taxonomy", "file_type": "rationale", "source_file": "docs/adr/ADR-0106-release-sign-off-is-governed-by-a-permanent-five-category-engineering-readiness-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every finding is exactly one of Release Blocking, Disclosed Non-Blocking, or Pre-Existing Unaffected, classified by its own nature \u2014 category and release status are consequences, never inputs; corrected after the original wording made CERTIFIED WITH ACCEPTED TECHNICAL DEBT unreachable."}, {"id": "docs_adr_adr_0106_release_sign_off_is_governed_by_a_permanent_five_category_engineering_readiness_review_four_value_verdict_vocabulary", "label": "Four-Value Verdict Vocabulary", "file_type": "rationale", "source_file": "docs/adr/ADR-0106-release-sign-off-is-governed-by-a-permanent-five-category-engineering-readiness-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NOT READY, ACCEPT WITH OBSERVATIONS, CERTIFIED WITH ACCEPTED TECHNICAL DEBT, CERTIFIED \u2014 derived once in strict priority order over every finding, so exactly one verdict is reachable."}, {"id": "docs_adr_adr_0106_release_sign_off_is_governed_by_a_permanent_five_category_engineering_readiness_review_six_discipline_programme_review", "label": "Six-Discipline Programme Review", "file_type": "rationale", "source_file": "docs/adr/ADR-0106-release-sign-off-is-governed-by-a-permanent-five-category-engineering-readiness-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chief Architect, Principal Software Engineer, Workflow Engineer, QA Lead, Technical Author, Product Manager each review independently before reconciliation; WP 11.9.0's QA Lead found TD-42/TD-43 only because of this independence."}, {"id": "docs_adr_adr_0106_release_sign_off_is_governed_by_a_permanent_five_category_engineering_readiness_review_product_approval", "label": "Product Approval", "file_type": "concept", "source_file": "docs/adr/ADR-0106-release-sign-off-is-governed-by-a-permanent-five-category-engineering-readiness-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The tier that issues the verdict (Engineering Governance \u00a79, FOUNDATION non-negotiable 8); the Technical Review tier recommends."}, {"id": "docs_adr_adr_0106_release_sign_off_is_governed_by_a_permanent_five_category_engineering_readiness_review_engineering_readiness_review_architecture", "label": "Engineering Readiness Review Architecture.md", "file_type": "document", "source_file": "docs/adr/ADR-0106-release-sign-off-is-governed-by-a-permanent-five-category-engineering-readiness-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_adr_adr_0106_release_sign_off_is_governed_by_a_permanent_five_category_engineering_readiness_review_engineering_readiness_review", "target": "docs_adr_adr_0106_release_sign_off_is_governed_by_a_permanent_five_category_engineering_readiness_review_adr_0106", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-0106-release-sign-off-is-governed-by-a-permanent-five-category-engineering-readiness-review.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_0106_release_sign_off_is_governed_by_a_permanent_five_category_engineering_readiness_review_six_discipline_programme_review", "target": "docs_adr_adr_0106_release_sign_off_is_governed_by_a_permanent_five_category_engineering_readiness_review_adr_0106", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-0106-release-sign-off-is-governed-by-a-permanent-five