{"nodes": [{"id": "docs_architecture_runtime_state_machine_runtime_state_machine", "label": "Runtime State Machine", "file_type": "document", "source_file": "docs/architecture/Runtime State Machine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_runtime_state_machine_tempesthost", "label": "TempestHost", "file_type": "concept", "source_file": "docs/architecture/Runtime State Machine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_runtime_state_machine_hoststate", "label": "HostState", "file_type": "rationale", "source_file": "docs/architecture/Runtime State Machine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seven states: Created, Starting, Running, Stopping, Stopped, Faulted, Disposed."}, {"id": "docs_architecture_runtime_state_machine_phases_within_states", "label": "Phases Within States", "file_type": "rationale", "source_file": "docs/architecture/Runtime State Machine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lifecycle phases are finer-grained than states; fifteen phases map onto seven states and adding plugin or hosted-service phases introduced no new state or transition."}, {"id": "docs_architecture_runtime_state_machine_starting_to_stopping_not_a_fault", "label": "Starting to Stopping Not a Fault", "file_type": "rationale", "source_file": "docs/architecture/Runtime State Machine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ADR-0018: startup cancellation or an early shutdown request passes through Stopping exactly like a graceful shutdown, so there is one path to Stopped, not two."}, {"id": "docs_architecture_runtime_state_machine_disposed_terminal_state", "l