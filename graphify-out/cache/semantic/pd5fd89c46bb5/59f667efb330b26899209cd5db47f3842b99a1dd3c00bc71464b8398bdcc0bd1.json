{"nodes": [{"id": "docs_academy_06_engineering_standards_05_release_engineering_engineering_standard__release_engineering", "label": "Engineering Standard: Release Engineering", "file_type": "document", "source_file": "docs/academy/06 Engineering Standards/05-release-engineering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_academy_06_engineering_standards_05_release_engineering__github_workflows_release_yml", "label": ".github/workflows/release.yml", "file_type": "concept", "source_file": "docs/academy/06 Engineering Standards/05-release-engineering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_academy_06_engineering_standards_05_release_engineering_scripts_new_release_ps1", "label": "scripts/new-release.ps1", "file_type": "concept", "source_file": "docs/academy/06 Engineering Standards/05-release-engineering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_academy_06_engineering_standards_05_release_engineering_branching_strategy", "label": "Branching Strategy", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/05-release-engineering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "main is the only permanent branch; a release integrates on release/vX.Y.Z; no develop or staging branch, deliberately never needed."}, {"id": "docs_academy_06_engineering_standards_05_release_engineering_merge_commit_never_squash", "label": "Merge Commit Never Squash", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/05-release-engineering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Squash or rebase would erase the Work-Package-level history the Academy and Technical Debt Register depend on."}, {"id": "docs_academy_06_engineering_standards_05_release_engineering_pull_request_template", "label": "Pull Request Template", "file_type": "concept", "source_file": "docs/academy/06 Engineering Standards/05-release-engineering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_academy_06_engineering_standards_05_release_engineering_codeowners", "label": "CODEOWNERS", "file_type": "concept", "source_file": "docs/academy/06 Engineering Standards/05-release-engineering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_academy_06_engineering_standards_05_release_engineering_tag_only_from_main_post_merge", "label": "Tag Only from main Post-Merge", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/05-release-engineering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "v0.10.0 and v0.11.0 both tagged the feature branch pre-merge tip; relying on the rule being obvious failed silently twice."}, {"id": "docs_academy_06_engineering_standards_05_release_engineering_wait_for_ci_gate_on_tagged_commit", "label": "Wait for CI Gate on Tagged Commit", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/05-release-engineering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "release.yml publishes nothing until the tagged commit CI Gate concludes success; polls the Checks API up to 75 minutes; a red, cancelled or missing gate fails the run and the tag stays."}, {"id": "docs_academy_06_engineering_standards_05_release_engineering_publish_job_token_split", "label": "Publish Job Token Split", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/05-release-engineering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the final publish job holds a repository-writing token; build/test runs read-only and hands assets plus SHA256SUMS.txt over as an artifact, verified before the Release is created."}, {"id": "docs_academy_06_engineering_standards_05_release_engineering_two_release_assets_never_one", "label": "Two Release Assets Never One", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/05-release-engineering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tempest.Desktop and Tempest.Harness builds attached separately so it is never ambiguous which download is TempestOS."}, {"id": "docs_academy_06_engineering_standards_05_release_engineering_velopack_installer_vpk", "label": "Velopack Installer vpk", "file_type": "concept", "source_file": "docs/academy/06 Engineering Standards/05-release-engineering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_academy_06_engineering_standards_05_release_engineering_version_file", "label": "VERSION File", "file_type": "concept", "source_file": "docs/academy/06 Engineering Standards/05-release-engineering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_academy_06_engineering_standards_05_release_engineering_patch_means_hotfix_only", "label": "PATCH Means Hotfix Only", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/05-release-engineering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PATCH is a hotfix and only a hotfix, never a vehicle for new capability; MAJOR reserved for v1.0.0."}, {"id": "docs_academy_06_engineering_standards_05_release_engineering_emergency_hotfix_process", "label": "Emergency Hotfix Process", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/05-release-engineering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Branch from the affected tag, minimal fix only, every gate applies, PATCH bump, then forward-merge into the active release branch: an omitted forward-merge is how a hotfix silently regresses."}, {"id": "docs_academy_06_engineering_standards_05_release_engineering_rollback_is_always_forward", "label": "Rollback Is Always Forward", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/05-release-engineering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A published tag is immutable; a defective release is marked superseded and a hotfix ships; the WP 11.4B exception touches only a tag mechanical position before branch close, never content."}, {"id": "docs_academy_06_engineering_standards_05_release_engineering_release_candidate_tag", "label": "Release Candidate Tag", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/05-release-engineering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "vX.Y.Z-rc.N cut on the release branch is the one disclosed exception to tag only from main."}, {"id": "docs_academy_06_engineering_standards_05_release_engineering_install_test_build_ps1", "label": "install-test-build.ps1", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/05-release-engineering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every build handed to the Product Owner ships its own installer and a versioned desktop shortcut after an old shortcut opened v0.22.0 data during a v0.23.0 test and looked like lost projects."}, {"id": "docs_academy_06_engineering_standards_05_release_engineering_release_readiness_review", "label": "Release-Readiness Review", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/05-release-engineering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "APPROVED or CERTIFIED recommendation required, a standing requirement since v0.6.0."}, {"id": "docs_academy_06_engineering_standards_05_release_engineering_wp_11_1b", "label": "WP 11.1B", "file_type": "concept", "source_file": "docs/academy/06 Engineering Standards/05-release-engineering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_academy_06_engineering_standards_05_release_engineering_wp_11_4b_release_process_correction", "label": "WP 11.4B Release Process Correction", "file_type": "concept", "source_file": "docs/academy/06 Engineering Standards/05-release-engineering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_academy_06_engineering_standards_05_release_engineering_v0_10_0_tag_deviation", "label": "v0.10.0 Tag Deviation", "file_type": "concept", "source_file": "docs/academy/06 Engineering Standards/05-release-engineering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_academy_06_engineering_standards_05_release_engineering_engineering_standard__release_engineering", "target": "docs_academy_06_engineering_standards_05_release_engineering__github_workflows_release_yml", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/academy/06 Engineering Standards/05-release-engineering.md", "source_location": null, "weight": 1.0}, {"source": "docs_academy_06_engineering_standards_05_release_engineering_engineering_standard__release_enginee