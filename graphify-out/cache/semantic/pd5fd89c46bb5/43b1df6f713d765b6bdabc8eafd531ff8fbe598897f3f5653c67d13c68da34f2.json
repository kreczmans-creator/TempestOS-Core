{"nodes": [{"id": "docs_adr_adr_0156_project_centric_numbering_and_one_customers_and_suppliers_list_adr_0156", "label": "ADR-0156", "file_type": "document", "source_file": "docs/adr/ADR-0156-project-centric-numbering-and-one-customers-and-suppliers-list.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Staff keep contact details only; customers and suppliers share one Organisation list (Customer/Supplier/Both from Roles) picked from a drop-down everywhere; numbering is project-centric \u2014 a five-character customer code and six-character project reference give CUSTOMER-PROJECTREF and CUSTOMER-PROJECTREF-DOCTYPE-NNN per project per type from 001; old identifiers stay as the fallback."}, {"id": "docs_adr_adr_0156_project_centric_numbering_and_one_customers_and_suppliers_list_project_centric_numbering", "label": "Project-Centric Numbering", "file_type": "rationale", "source_file": "docs/adr/ADR-0156-project-centric-numbering-and-one-customers-and-suppliers-list.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Like document numbering, e.g. ACME1-BRIDG1-Q-001; the prefix is frozen at project creation from the project's own identifier, so changing a customer code later renumbers nothing."}, {"id": "docs_adr_adr_0156_project_centric_numbering_and_one_customers_and_suppliers_list_projectnumbering", "label": "ProjectNumbering", "file_type": "code", "source_file": "docs/adr/ADR-0156-project-centric-numbering-and-one-customers-and-suppliers-list.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tempest.Core.Projects \u2014 DocumentTypes table, SuggestCustomerCode/SuggestProjectReference (first letters and digits padded with X, stepping the last characters on a clash), TryParseProjectIdentifier (also recognises the earlier all-letter AAAAA-BBBBB form)."}, {"id": 