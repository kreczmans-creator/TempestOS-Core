{"nodes": [{"id": "docs_adr_adr_0161_second_person_sign_off_is_one_global_switch_off_by_default_and_a_self_approval_says_so_adr_0161", "label": "ADR-0161", "file_type": "document", "source_file": "docs/adr/ADR-0161-second-person-sign-off-is-one-global-switch-off-by-default-and-a-self-approval-says-so.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One global switch, ISignOffPolicy (Governance.SecondPersonSignOff, off by default), governs every separation-of-duty rule; off relaxes only 'must be somebody else' and a self-approval is marked in the record and the audit row; on restores every colour review board B1 rule; changing the switch is itself audited."}, {"id": "docs_adr_adr_0161_second_person_sign_off_is_one_global_switch_off_by_default_and_a_self_approval_says_so_isignoffpolicy", "label": "ISignOffPolicy / SignOffPolicy", "file_type": "code", "source_file": "docs/adr/ADR-0161-second-person-sign-off-is-one-global-switch-off-by-default-and-a-self-approval-says-so.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tempest.Core.Governance, registered once in TempestHost over ISettingsProvider; a saved value wins over configuration Governance:SecondPersonSignOff; every separation-of-duty rule consults it rather than holding a switch of its own."}, {"id": "docs_adr_adr_0161_second_person_sign_off_is_one_global_switch_off_by_default_and_a_self_approval_says_so_governance_secondpersonsignoff_setting", "label": "Governance.SecondPersonSignOff", "file_type": "concept", "source_file": "docs/adr/ADR-0161-second-person-sign-off-is-one-global-switch-off-by-default-and-a-self-approval-says-so.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_0161_second_person_sign_off_is_one_global_switch_off_by_default_and_a_self_approval_says_so_self_approval_is_marked", "label": "A Self-Approval Says So", "file_type": "rationale", "source_file": "docs/adr/ADR-0161-second-person-sign-off-is-one-global-switch-off-by-default-and-a-self-approval-says-so.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "QuotationRevision.SelfApproved and CheckRecord.SelfCheck true, audit detail ending 'self-approval: second-person sign-off is off'; both new JSON members default false, which is true of earlier records since the rule was then on; nothing a self-approval produces claims an independence it did not have."}, {"id": "docs_adr_adr_0161_second_person_sign_off_is_one_global_switch_off_by_default_and_a_self_approval_says_so_single_user_consultancy_default", "label": "Single-User Consultancy Default", "file_type": "rationale", "source_file": "docs/adr/ADR-0161-second-person-sign-off-is-one-global-switch-off-by-default-and-a-self-approval-says-so.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PO: this software is initially for a single-user consultancy, so everything needing a second person cannot be the case \u2014 the v0.23.0 quote rule had made every quote unsendable because nobody else exists to approve it."}, {"id": "docs_adr_adr_0161_second_person_sign_off_is_one_global_switch_off_by_default_and_a_self_approval_says_so_switch_change_is_audited", "label": "Changing the Switch Is Audited", "file_type": "rationale", "source_file": "docs/adr/ADR-0161-second-person-sign-off-is-one-global-switch-off-by-default-and-a-self-approval-says-so.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SetSecondPersonRequiredAsync writes the setting and an audit row governance.second-person-sign-off.changed (Subject, OldValue, NewValue) via IAuditRecorder; the policy is a setting any signed-in person can change because TempestOS has one session principal (ADR-0146) \u2014 the audit row is the control."}, {"id": "docs_adr_adr_0161_second_person_sign_off_is_one_global_switch_off_by_default_and_a_self_approval_says_so_isettingsprovider", "label": "ISettingsProvider", "file_type": "code", "source_file": "docs/adr/ADR-0161-second-person-sign-off-is-one-global-switch-off-by-default-and-a-self-approval-says-so.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_0161_second_person_sign_off_is_one_global_switch_off_by_default_and_a_self_approval_says_so_iauditrecorder", "label": "IAuditRecorder", "file_type": "code", "source_file": "docs/adr/ADR-0161-second-person-sign-off-is-one-global-switch-off-by-default-and-a-self-approval-says-so.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_0161_second_person_sign_off_is_one_global_switch_off_by_default_and_a_self_approval_says_so_settings_sign_off_section", "label": "Settings \u2192 Sign-off", "file_type": "concept", "source_file": "docs/adr/ADR-0161-second-person-sign-off-is-one-global-switch-off-by-default-and-a-self-approval-says-so.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One switch, automation name Second-person sign-off; the Quote tab's review panel states whether self-approval is allowed and marks a self-approved revision."}, {"id": "docs_adr_adr_0161_second_person_sign_off_is_one_global_switch_off_by_default_and_a_self_approval_says_so_exactly_two_separation_of_duty_rules", "label": "Exactly Two Separation-of-Duty Rules Exist", "file_type": "rationale", "source_file": "docs/adr/ADR-0161-second-person-sign-off-is-one-global-switch-off-by-default-and-a-self-approval-says-so.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A code survey found only the quote approval rule and Evidence's independent check; ReferenceReviewService never required verifier, releaser and author to differ, and AssetGovernanceRules.SelfReviewed is a warning, never a refusal \u2014 so it does not consult the policy, but must if such a rule is added."}], "edges": [{"source": "docs_adr_adr_0161_second_person_sign_off_is_one_global_switch_off_by_default_and_a_self_approval_says_so_adr_0161", "target": "docs_adr_adr_0152_a_quotation_opened_with_the_project_defines_its_deliverables_and_initial_requirements_adr_0152", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-0161-second-person-sign-off-is-one-global-switch-off-by-default-and-a-self-approval-says-so.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_0161_second_person_sign_off_is_one_global_switch_off_by_default_and_a_self_approval_says_so_adr_0161", "target": "docs_adr_adr_0148_evidence_is_a_canonical_kind_specialising_the_lifecycle_and_citing_governed_reference_data_adr_0148", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-0161-second-person-sign-off-is-one-global-switch-off-by-default-and-a-self-approval-says-so.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_0161_second_person_sign_off_is_one_global_switch_off_by_default_and_a_self_approval_says_so_adr_0161", "target": "docs_governance_architecture_adr_register_adr_0041", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-0161-second-person-sign-off-is-one-global-switch-off-by-default-and-a-self-approval-says-so.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_0161_second_person_sign_off_is_one_global_switch_off_by_default_and_a_self_approval_says_so_adr_0161", "target": "docs_governance_architecture_adr_register_adr_0045", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR