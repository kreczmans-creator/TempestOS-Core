{"nodes": [{"id": "contributing_contributing", "label": "Contributing to TempestOS", "file_type": "document", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contributing_work_package", "label": "Work Package \u2014 a branch and a pull request; the PR description is the retrospective", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No separate retrospective document, readiness review or completion certification; the PR says what changed, why, and what evidence backs it."}, {"id": "contributing_one_round_review", "label": "One review per PR, one round", "file_type": "rationale", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Findings are fixed in the same PR or filed to BACKLOG.md before merge; never silently dropped and never allowed to reopen a second round."}, {"id": "contributing_release_blocking", "label": "Release Blocking \u2014 only data loss a user can reproduce from the running UI", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Everything else is real but belongs in BACKLOG.md, not in the way of the merge."}, {"id": "contributing_markdown_budget", "label": "Markdown budget \u2014 a PR may not add more Markdown lines than code lines", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enforced by governance-healthcheck.ps1 against git diff --numstat versus the merge base with main; stops the process outweighing the product."}, {"id": "contributing_definition_of_done", "label": "Definiti