{"nodes": [{"id": "docs_adr_adr_0158_calculator_reference_diagrams_are_declared_per_calculation_in_core_and_drawn_by_one_desktop_control_adr_0158", "label": "ADR-0158", "file_type": "document", "source_file": "docs/adr/ADR-0158-calculator-reference-diagrams-are-declared-per-calculation-in-core-and-drawn-by-one-desktop-control.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each calculator's reference diagram is declared as data in Core (CalculationDiagramSpec, one per calculation, variants selected by the form's own values) and drawn by one Desktop control beside the inputs, not to scale and inputs only; a calculation is complete only with its diagram, enforced by a coverage test."}, {"id": "docs_adr_adr_0158_calculator_reference_diagrams_are_declared_per_calculation_in_core_and_drawn_by_one_desktop_control_calculationdiagramspec", "label": "CalculationDiagramSpec", "file_type": "code", "source_file": "docs/adr/ADR-0158-calculator-reference-diagrams-are-declared-per-calculation-in-core-and-drawn-by-one-desktop-control.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tempest.Core.Calculations.Modules.Diagrams: variants of shapes on a 400 \u00d7 240 sheet (members, plates, circles, supports, loads, moments, springs, dimensions, labels, polylines, axes), each bound by name to the input it stands for."}, {"id": "docs_adr_adr_0158_calculator_reference_diagrams_are_declared_per_calculation_in_core_and_drawn_by_one_desktop_control_calculationdiagrams_all", "label": "CalculationDiagrams.All", "file_type": "code", "source_file": "docs/adr/ADR-0158-calculator-reference-diagrams-are-declared-per-calculation-in-core-and-drawn-by-one-desktop-control.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_0158_calculator_reference_diagrams_are_declared_per_calculation_in_core_and_drawn_by_one_desktop_control_calculationdiagramreader", "label": "CalculationDiagramReader", "file_type": "code", "source_file": "docs/adr/ADR-0158-calculator-reference-diagrams-are-declared-per-calculation-in-core-and-drawn-by-one-desktop-control.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Labels a bound shape 'L = 2000 mm' or 'L = ?' using the calculation's own unit parser; never guesses, never computes a result; also yields the screen-reader summary."}, {"id": "docs_adr_adr_0158_calculator_reference_diagrams_are_declared_per_calculation_in_core_and_drawn_by_one_desktop_control_calculationdiagramview", "label": "CalculationDiagramView", "file_type": "code", "source_file": "docs/adr/ADR-0158-calculator-reference-diagrams-are-declared-per-calculation-in-core-and-drawn-by-one-desktop-control.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain Avalonia shapes from the spec, coloured from BrandPalette/ApplicationPalette tokens, marked 'Not to scale \u00b7 inputs only', focus highlight both ways."}, {"id": "docs_adr_adr_0158_calculator_reference_diagrams_are_declared_per_calculation_in_core_and_drawn_by_one_desktop_control_calculationmodulesview", "label": "CalculationModulesView", "file_type": "code", "source_file": "docs/adr/ADR-0158-calculator-reference-diagrams-are-declared-per-calculation-in-core-and-drawn-by-one-desktop-control.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Places the diagram beside the inputs, or above them under DiagramBesideMinimumWidth (a 1180 \u00d7 760 laptop window), redrawing on every field change."}, {"id": "docs_adr_adr_0158_calculator_reference_diagrams_are_declared_per_calculation_in_core_and_drawn_by_one_desktop_control_calculationmoduledescriptors", "label": "CalculationModuleDescriptors", "file_type": "code", "source_file": "docs/adr/ADR-0158-calculator-reference-diagrams-are-declared-per-calculation-in-core-and-drawn-by-one-desktop-control.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_0158_calculator_reference_diagrams_are_declared_per_calculation_in_core_and_drawn_by_one_desktop_control_diagram_is_data_in_core", "label": "A Diagram Is Data, in Core", "file_type": "rationale", "source_file": "docs/adr/ADR-0158-calculator-reference-diagrams-are-declared-per-calculation-in-core-and-drawn-by-one-desktop-control.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Images per calculation cannot label live values or highlight a shape and drift silently; drawing code per calculation in Desktop is untestable without a window and has no coverage check against the descriptors."}, {"id": "docs_adr_adr_0158_calculator_reference_diagrams_are_declared_per_calculation_in_core_and_drawn_by_one_desktop_control_calculation_complete_only_with_diagram", "label": "A Calculation Is Complete Only With Its Diagram", "file_type": "rationale", "source_file": "docs/adr/ADR-0158-calculator-reference-diagrams-are-declared-per-calculation-in-core-and-drawn-by-one-desktop-control.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Engineering Principle 33 (PO, 2026-10-01): a Core test requires every calculation in CalculationModuleDescriptors.All to have exactly one diagram, every bound input to exist and every choice combination to select a variant \u2014 a new calculation ships with its diagram or the build is red."}, {"id": "docs_adr_adr_0158_calculator_reference_diagrams_are_declared_per_calculation_in_core_and_drawn_by_one_desktop_control_not_to_scale_inputs_only", "label": "Not to Scale, Inputs Only", "file_type": "rationale", "source_file": "docs/adr/ADR-0158-calculator-reference-diagrams-are-declared-per-calculation-in-core-and-drawn-by-one-desktop-control.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Product Owner's answers: a fixed panel beside the inputs, no deflected shape, no stress marker; a bolt, pin or point is a solid circle, never a hole; an input the method does not take is not drawn."}, {"id": "docs_adr_adr_0158_calculator_reference_diagrams_are_declared_per_calculation_in_core_and_drawn_by_one_desktop_control_po_2_feedback", "label": "PO-2 Feedback (2026-10-01)", "file_type": "concept", "source_file": "docs/adr/ADR-0158-calculator-reference-diagrams-are-declared-per-calculation-in-core-and-drawn-by-one-desktop-control.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_0158_calculator_reference_diagrams_are_declared_per_calculation_in_core_and_drawn_by_one_desktop_control_rc_po_feedback_actions", "label": "RC PO Feedback Actions (2026-10-01).md", "file_type": "document", "source_file": "docs/adr/ADR-0158-calculator-reference-diagrams-are-declared-per-calculation-in-core-and-drawn-by-one-desktop-control.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_adr_adr_0158_calculator_reference_diagrams_are_declared_per_calculation_in_core_and_drawn_by_one_desktop_control_diagram_is_data_in_core", "target": "docs_adr_adr_0158_calculator_reference_diagrams_are_declared_per_calculation_in_core_and_drawn_by_one_desktop_control_adr_0158", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-0158-calculator-reference-diagrams-are-declared-per-calculation-in-core-and-drawn-by-one-desktop-control.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_0158_calculator_reference_diagrams_are_declared_per_calcu