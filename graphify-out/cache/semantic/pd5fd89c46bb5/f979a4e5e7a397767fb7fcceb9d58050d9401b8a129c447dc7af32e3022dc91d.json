{"nodes": [{"id": "docs_adr_adr_0129_business_governance_records_reuse_the_shared_reference_data_lifecycle_and_keep_domain_status_separate_adr_0129", "label": "ADR-0129", "file_type": "document", "source_file": "docs/adr/ADR-0129-business-governance-records-reuse-the-shared-reference-data-lifecycle-and-keep-domain-status-separate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every P07 business record library is a ReferenceDataCatalog<TDefinition> sharing the Group A governance lifecycle, while domain status (ContractStatus, PolicyStatus, PipelineStage) is a separate axis on the definition \u2014 collapsing the two is how a system reports a draft as a signed contract."}, {"id": "docs_adr_adr_0129_business_governance_records_reuse_the_shared_reference_data_lifecycle_and_keep_domain_status_separate_referencedatacatalog", "label": "ReferenceDataCatalog<TDefinition>", "file_type": "code", "source_file": "docs/adr/ADR-0129-business-governance-records-reuse-the-shared-reference-data-lifecycle-and-keep-domain-status-separate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared catalogue base (ADR-0126) giving provenance, supersede-not-edit, permanent revisions, ReferencePin traceability and per-library validation for free."}, {"id": "docs_adr_adr_0129_business_governance_records_reuse_the_shared_reference_data_lifecycle_and_keep_domain_status_separate_domain_status_separate_axis", "label": "Domain Status Is a Separate Axis", "file_type": "rationale", "source_file": "docs/adr/ADR-0129-business-governance-records-reuse-the-shared-reference-data-lifecycle-and-keep-domain-status-separate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A record can be Released (accurate, checked) while the contract is in negotiation; reusing ReferenceValidationState as contract status would make an accurate record of a draft contract impossible to express."}, {"id": "docs_adr_adr_0129_business_governance_records_reuse_the_shared_reference_data_lifecycle_and_keep_domain_status_separate_businessgovernancefacts", "label": "BusinessGovernanceFacts", "file_type": "code", "source_file": "docs/adr/ADR-0129-business-governance-records-reuse-the-shared-reference-data-lifecycle-and-keep-domain-status-separate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owner, classification, review schedule, authorisations, outstanding authorities, evidence \u2014 composed as a property, not inherited from a base class."}, {"id": "docs_adr_adr_0129_business_governance_records_reuse_the_shared_reference_data_lifecycle_and_keep_domain_status_separate_businessgovernancevalidator", "label": "BusinessGovernanceValidator", "file_type": "code", "source_file": "docs/adr/ADR-0129-business-governance-records-reuse-the-shared-reference-data-lifecycle-and-keep-domain-status-separate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checks shared facts once (TEMPEST-BGV-001\u2013010); each package's service calls it rather than eleven copies."}, {"id": "docs_adr_adr_0129_business_governance_records_reuse_the_shared_reference_data_lifecycle_and_keep_domain_status_separate_referencevalidationstate", "label": "ReferenceValidationState", "file_type": "code", "source_file": "docs/adr/ADR-0129-business-governance-records-reuse-the-shared-reference-data-lifecycle-and-keep-domain-status-separate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_0129_business_governance_records_reuse_the_shared_reference_data_lifecycle_and_keep_domain_status_separate_p07_business_governance", "label": "P07 Business Governance & Scale", "file_type": "concept", "source_file": "docs/adr/ADR-0129-business-governance-records-reuse-the-shared-reference-data-lifecycle-and-keep-domain-status-separate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Independent of P01/P02; reads only the document store, persistence and identity."}, {"id": "docs_adr_adr_0129_business_governance_records_reuse_the_shared_reference_data_lifecycle_and_keep_domain_status_separate_p07_business_record_libraries", "label": "P07 Business Record Libraries", "file_type": "concept", "source_file": "docs/adr/ADR-0129-business-governance-records-reuse-the-shared-reference-data-lifecycle-and-keep-domain-status-separate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BusinessContractTemplates, BusinessContracts, BusinessRisks, BusinessInsurancePolicies, BusinessIPAssets, BusinessDataAssets, BusinessRateCards, BusinessFinancialAssumptions, BusinessFinancialScenarios, BusinessOpportunities, BusinessOperatingModels; most frozen by WP 18.0C, Contracts and PricingService returned by ADR-0154."}, {"id": "docs_adr_adr_0129_business_governance_records_reuse_the_shared_reference_data_lifecycle_and_keep_domain_status_separate_governance_facts_composed_not_inherited", "label": "Governance Facts Composed, Not Inherited", "file_type": "rationale", "source_file": "docs/adr/ADR-0129-business-governance-records-reuse-the-shared-reference-data-lifecycle-and-keep-domain-status-separate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A BusinessObject base class would force eleven unrelated domains through one schema with a nullable field per difference \u2014 rejected as ADR-0126 rejected it for Group A."}], "edges": [{"source": "docs_adr_adr_0129_business_governance_records_reuse_the_shared_reference_data_lifecycle_and_keep_domain_status_separate_adr_0129", "target": "docs_gove