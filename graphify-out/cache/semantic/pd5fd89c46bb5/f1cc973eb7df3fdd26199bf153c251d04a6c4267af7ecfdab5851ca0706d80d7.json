{"nodes": [{"id": "docs_academy_06_engineering_standards_04_continuous_integration_engineering_standard__continuous_integration", "label": "Engineering Standard: Continuous Integration", "file_type": "document", "source_file": "docs/academy/06 Engineering Standards/04-continuous-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_academy_06_engineering_standards_04_continuous_integration_adr_0160", "label": "ADR-0160", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/04-continuous-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PO decision 2026-10-01: pull requests test Release only, the release waits for CI Gate on the tagged commit, and every restore is locked via packages.lock.json."}, {"id": "docs_academy_06_engineering_standards_04_continuous_integration_ci_gate", "label": "CI Gate", "file_type": "concept", "source_file": "docs/academy/06 Engineering Standards/04-continuous-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_academy_06_engineering_standards_04_continuous_integration__github_workflows_ci_yml", "label": ".github/workflows/ci.yml", "file_type": "concept", "source_file": "docs/academy/06 Engineering Standards/04-continuous-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_academy_06_engineering_standards_04_continuous_integration_pipeline_verifies_existing_standards", "label": "Pipeline Verifies Existing Standards", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/04-continuous-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every gate the workflow enforces was already required of every Work Package; v1.0 readiness needed the existing bar made impossible to quietly miss, not a new one."}, {"id": "docs_academy_06_engineering_standards_04_continuous_integration_fail_loudly_disclose_fully", "label": "Fail Loudly Disclose Fully", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/04-continuous-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every step checks its own exit code and fails on the first error; summary and artifact steps run even on failure (if: always()) so a failing run is diagnosable from the Actions UI alone."}, {"id": "docs_academy_06_engineering_standards_04_continuous_integration_treatwarningsaserrors_ci_override", "label": "TreatWarningsAsErrors CI Override", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/04-continuous-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Directory.Build.props leaves it false so local builds behave as always; CI passes -p:TreatWarningsAsErrors=true as an invocation override, verified safe against a zero-warning tree before adoption."}, {"id": "docs_academy_06_engineering_standards_04_continuous_integration_build_and_test_matrix", "label": "Build and Test Matrix", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/04-continuous-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "2 x 4: Debug and Release times core plus three Desktop shards split by namespace first letter, fail-fast false so one leg never hides another."}, {"id": "docs_academy_06_engineering_standards_04_continuous_integration_cishardcoveragetests", "label": "CiShardCoverageTests", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/04-continuous-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fails if a Desktop test falls outside every shard filter or inside two of them."}, {"id": "docs_academy_06_engineering_standards_04_continuous_integration_pull_requests_test_release_only", "label": "Pull Requests Test Release Only", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/04-continuous-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Debug legs still build with warnings as errors but skip tests on a pull request; pushes to main, release branches, tags and manual runs test both; skipping is per step so leg names never change."}, {"id": "docs_academy_06_engineering_standards_04_continuous_integration_locked_restore", "label": "Locked Restore", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/04-continuous-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "packages.lock.json pins every direct and transitive package by version and content hash; --locked-mode and RestoreLockedMode under CI=true make a drifted lock fail (NU1004/NU1403) instead of resolving something new."}, {"id": "docs_academy_06_engineering_standards_04_continuous_integration_runtimeidentifiers_win_x64_linux_x64", "label": "RuntimeIdentifiers win-x64 linux-x64", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/04-continuous-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A lock records the RIDs it was restored for, so both RIDs in every lock let Windows legs, the win-x64 publish and the Linux smoke job restore against the same committed files."}, {"id": "docs_academy_06_engineering_standards_04_continuous_integration_global_json_sdk_pin", "label": "global.json SDK Pin", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/04-continuous-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "actions/setup-dotnet reads the same global.json every local build reads so SDK version cannot drift between a contributor machine and CI."}, {"id": "docs_academy_06_engineering_standards_04_continuous_integration_pinned_windows_2022_runner", "label": "Pinned windows-2022 Runner", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/04-continuous-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Floating windows-latest rejected for the same reason every package version is pinned: an unannounced image change should never silently change CI behaviour."}, {"id": "docs_academy_06_engineering_standards_04_continuous_integration_finding_r_1", "label": "Finding R-1", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/04-continuous-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WP11.0A: nothing prevented a regression reaching main other than the discipline of whoever ran the Work Package."}, {"id": "docs_academy_06_engineering_standards_04_continuous_integration_wp_11_1a", "label": "WP 11.1A", "file_type": "concept", "source_file": "docs/academy/06 Engineering Standards/04-continuous-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_academy_06_engineering_standards_04_continuous_integration_dependency_scan", "label": "Dependency Scan", "file_type": "concept", "source_file": "docs/academy/06 Engineering Standards/04-continuous-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_academy_06_engineering_standards_04_continuous_integration_build_gate", "label": "Build Gate", "file_type": "concept", "source_file": "docs/academy/06 Engineering Standards/04-continuous-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_academy_06_engineering_standards_04_continuous_integration_test_gate", "label": "Test Gate", "file_type": "concept", "source_file": "docs/academy/06 Engineering Standards/04-continuous-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_academy_06_engineering_standards_04_continuous_integration_single_platform_disclosure", "label": "Single Platform Disclosure", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/04-continuous-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pipeline runs on windows-2022 only; cross-platform correctness never verified despite Avalonia."}], "edges": [{"source": "docs_academy_06_engineering_standards_04_continuous_integration_engineering_standard__continuous_integration", "target": "docs_academy_06_engineering_standards_04_continuous_integration__github_workflows_ci_yml", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/academy/06 Engineering Standards/04-continuous-integration.md", "source_location": null, "weight": 1.0}, {"source": "docs_academy_06_engineering_standards_04_continuous_integration_engineering_standard__continuous_integration", "target": "docs_academy_06_engineering_standards_04_continuous_integration_ci_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/academy/06 Engineering Standards/04-continuous-integration.md", "source_location": null, "weight": 1.0}, {"source":