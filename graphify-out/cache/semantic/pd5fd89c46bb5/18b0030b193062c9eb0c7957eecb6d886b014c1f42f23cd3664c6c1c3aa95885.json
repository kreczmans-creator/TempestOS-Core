{"nodes": [{"id": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_adr_0144", "label": "ADR-0144", "file_type": "document", "source_file": "docs/adr/ADR-0144-persistence-is-sqlite-in-wal-mode-with-full-synchronous-writes-and-the-file-per-key-store-is-retired.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The durable store is one SQLite database, tempest.db, in WAL mode with synchronous=FULL; SqlitePersistenceStore implements the unchanged IPersistenceStore/IBinaryPersistenceStore plus a new IQueryablePersistenceStore; the file-per-key store is retired because it could not fsync, query, transact or lock."}, {"id": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_sqlitepersistencestore", "label": "SqlitePersistenceStore", "file_type": "code", "source_file": "docs/adr/ADR-0144-persistence-is-sqlite-in-wal-mode-with-full-synchronous-writes-and-the-file-per-key-store-is-retired.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only type referencing Microsoft.Data.Sqlite; holds tempest.lock for its lifetime; one instance registered under three interfaces."}, {"id": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_persistencestore", "label": "PersistenceStore (file-per-key)", "file_type": "code", "source_file": "docs/adr/ADR-0144-persistence-is-sqlite-in-wal-mode-with-full-synchronous-writes-and-the-file-per-key-store-is-retired.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retained for exactly one release (Persistence:Backend=files) then deleted in WP 18.1A; its ExecuteInTransactionAsync was never atomic and said so in capitals."}, {"id": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_ipersistencestore", "label": "IPersistenceStore", "file_type": "code", "source_file": "docs/adr/ADR-0144-persistence-is-sqlite-in-wal-mode-with-full-synchronous-writes-and-the-file-per-key-store-is-retired.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_ibinarypersistencestore", "label": "IBinaryPersistenceStore", "file_type": "code", "source_file": "docs/adr/ADR-0144-persistence-is-sqlite-in-wal-mode-with-full-synchronous-writes-and-the-file-per-key-store-is-retired.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_iqueryablepersistencestore", "label": "IQueryablePersistenceStore", "file_type": "code", "source_file": "docs/adr/ADR-0144-persistence-is-sqlite-in-wal-mode-with-full-synchronous-writes-and-the-file-per-key-store-is-retired.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds the four things consumers had been simulating above the store: prefix ListKeysAsync, ReadAllAsync, ReadManyAsync and ExecuteInTransactionAsync."}, {"id": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_sqlite_wal_mode", "label": "SQLite WAL Mode", "file_type": "rationale", "source_file": "docs/adr/ADR-0144-persistence-is-sqlite-in-wal-mode-with-full-synchronous-writes-and-the-file-per-key-store-is-retired.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "synchronous=FULL in WAL mode fsyncs each commit before reporting it committed \u2014 the no-fsync defect closed at the root rather than half closed by WP 17.0A's WriteThrough temp file."}, {"id": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_four_connection_pragmas", "label": "Four Connection Pragmas", "file_type": "rationale", "source_file": "docs/adr/ADR-0144-persistence-is-sqlite-in-wal-mode-with-full-synchronous-writes-and-the-file-per-key-store-is-retired.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "busy_timeout=5000, journal_mode=WAL, synchronous=FULL, foreign_keys=ON in that order; the default busy timeout is zero, so a pragma issued before it fails outright rather than waiting."}, {"id": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_tempest_db", "label": "tempest.db", "file_type": "concept", "source_file": "docs/adr/ADR-0144-persistence-is-sqlite-in-wal-mode-with-full-synchronous-writes-and-the-file-per-key-store-is-retired.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_tempest_lock", "label": "tempest.lock", "file_type": "concept", "source_file": "docs/adr/ADR-0144-persistence-is-sqlite-in-wal-mode-with-full-synchronous-writes-and-the-file-per-key-store-is-retired.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Held open FileShare.None so a second instance over one root is refused with PersistenceStoreUnavailableException naming root and lock, closing the cross-process interleaving defect."}, {"id": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_records_table_schema_v1", "label": "Records Table Schema v1", "file_type": "concept", "source_file": "docs/adr/ADR-0144-persistence-is-sqlite-in-wal-mode-with-full-synchronous-writes-and-the-file-per-key-store-is-retired.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One records table (collection, key, text_value, blob_value, updated_utc) plus schema_info; a text write clears blob_value and vice versa, enforcing the bytes-are-bytes separation IBinaryPersistenceStore always intended."}, {"id": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_executeintransactionasync", "label": "ExecuteInTransactionAsync", "file_type": "code", "source_file": "docs/adr/ADR-0144-persistence-is-sqlite-in-wal-mode-with-full-synchronous-writes-and-the-file-per-key-store-is-retired.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs on its own connection under BEGIN IMMEDIATE so a contending transaction fails at its start, not half way; a call to the outer store from inside is a bounded busy-timeout failure, not a deadlock."}, {"id": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_tempesthost", "label": "TempestHost", "file_type": "code", "source_file": "docs/adr/ADR-0144-persistence-is-sqlite-in-wal-mode-with-full-synchronous-writes-and-the-file-per-key-store-is-retired.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Constructs one store, registers it under three interfaces via AddInstance (ADR-0044 pattern); its Service Disposal phase now disposes registered instances in reverse order, closing TD-03 for instance registrations only."}, {"id": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_microsoft_data_sqlite", "label": "Microsoft.Data.Sqlite 10.0.11", "file_type": "code", "source_file": "docs/adr/ADR-0144-persistence-is-sqlite-in-wal-mode-with-full-synchronous-writes-and-the-file-per-key-store-is-retired.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First NuGet package in Tempest.Core, spending ADR-0049's package-free position once on the one thing it cannot buy; the alternative is a hand-written P/Invoke layer with our bugs in it."}, {"id": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_persistence_backend_setting", "label": "Persistence:Backend", "file_type": "concept", "source_file": "docs/adr/ADR-0144-persistence-is-sqlite-in-wal-mode-with-full-synchronous-writes-and-the-file-per-key-store-is-retired.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sqlite (default) or files; an unrecognised value is a fatal configuration error, never a silent fallback (ADR-0013)."}, {"id": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_persistence_synchronous_normal_relaxation", "label": "Persistence:Synchronous=Normal Test-Only Relaxation", "file_type": "rationale", "source_file": "docs/adr/ADR-0144-persistence-is-sqlite-in-wal-mode-with-full-synchronous-writes-and-the-file-per-key-store-is-retired.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Set only by the Desktop test suite (about 4,900 commits per three-host test pushed CI past its 45-minute timeout); kept as an ordinary configuration key, so every store opened at NORMAL logs a Warning naming the key, root and durability given up."}, {"id": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_five_file_store_defects", "label": "Five File-per-Key Store Defects", "file_type": "rationale", "source_file": "docs/adr/ADR-0144-persistence-is-sqlite-in-wal-mode-with-full-synchronous-writes-and-the-file-per-key-store-is-retired.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No fsync of the rename (TD-137), O(N) directory scans (TD-12), no query, no multi-key transaction (TD-149, TD-156), no cross-process lock (TD-88) \u2014 plus the whole TD-59 file-name encoding apparatus that existed only because a key had to survive a file system."}], "edges": [{"source": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_adr_0144", "target": "docs_governance_architecture_adr_register_adr_0041", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-0144-persistence-is-sqlite-in-wal-mode-with-full-synchronous-writes-and-the-file-per-key-store-is-retired.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_adr_0144", "target": "docs_governance_architecture_adr_register_adr_0053", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-0144-persistence-is-sqlite-in-wal-mode-with-full-synchronous-writes-and-the-file-per-key-store-is-retired.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_adr_0144", "target": "docs_governance_architecture_adr_register_adr_0049", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-0144-persistence-is-sqlite-in-wal-mode-with-full-synchronous-writes-and-the-file-per-key-store-is-retired.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_adr_0144", "target": "docs_governance_architecture_adr_register_adr_0044", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-0144-persistence-is-sqlite-in-wal-mode-with-full-synchronous-writes-and-the-file-per-key-store-is-retired.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_adr_0144", "target": "docs_governance_architecture_adr_register_adr_0013", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-0144-persistence-is-sqlite-in-wal-mode-with-full-synchronous-writes-and-the-file-per-key-store-is-retired.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_five_file_store_defects", "target": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_adr_0144", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-0144-persistence-is-sqlite-in-wal-mode-with-full-synchronous-writes-and-the-file-per-key-store-is-retired.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_sqlite_wal_mode", "target": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous_writes_and_the_file_per_key_store_is_retired_adr_0144", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-0144-persistence-is-sqlite-in-wal-mode-with-full