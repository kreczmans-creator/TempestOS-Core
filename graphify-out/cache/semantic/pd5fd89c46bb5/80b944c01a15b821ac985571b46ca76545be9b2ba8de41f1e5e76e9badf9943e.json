{"nodes": [{"id": "docs_adr_adr_0148_evidence_is_a_canonical_kind_specialising_the_lifecycle_and_citing_governed_reference_data_adr_0148", "label": "ADR-0148", "file_type": "document", "source_file": "docs/adr/ADR-0148-evidence-is-a-canonical-kind-specialising-the-lifecycle-and-citing-governed-reference-data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evidence is a canonical Kind on Part's shape with its own EvidenceStatus enum and transition table (ADR-0074 specialisation), citing only Released reference records through ReferencePins; IEvidenceService decides every governed act and reports refusals as results, never exceptions."}, {"id": "docs_adr_adr_0148_evidence_is_a_canonical_kind_specialising_the_lifecycle_and_citing_governed_reference_data_evidence", "label": "Evidence", "file_type": "code", "source_file": "docs/adr/ADR-0148-evidence-is-a-canonical-kind-specialising-the-lifecycle-and-citing-governed-reference-data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Classification, tag SubjectId, AuthorIdentityId, Citations, DeclaredFigures (Quantity text), Status, Check, Issue; Classification and Status hide differently-typed base facet members."}, {"id": "docs_adr_adr_0148_evidence_is_a_canonical_kind_specialising_the_lifecycle_and_citing_governed_reference_data_evidencestatus", "label": "EvidenceStatus", "file_type": "code", "source_file": "docs/adr/ADR-0148-evidence-is-a-canonical-kind-specialising-the-lifecycle-and-citing-governed-reference-data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Draft, Checked, Issued, Superseded \u2014 Checked\u2248InReview, Issued\u2248Released; Issued\u2192Draft is ReviseAsync using the object's existing revision history, no second versioning mechanism."}, {"id": "docs_adr_adr_0148_evidence_is_a_canonical_kind_specialising_the_lifecycle_and_citing_governed_reference_data_evidencestatustransitions", "label": "EvidenceStatusTransitions", "file_type": "code", "source_file": "docs/adr/ADR-0148-evidence-is-a-canonical-kind-specialising-the-lifecycle-and-citing-governed-reference-data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_0148_evidence_is_a_canonical_kind_specialising_the_lifecycle_and_citing_governed_reference_data_ievidenceservice", "label": "IEvidenceService / EvidenceService", "file_type": "code", "source_file": "docs/adr/ADR-0148-evidence-is-a-canonical-kind-specialising-the-lifecycle-and-citing-governed-reference-data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The one governed seam: cited record's ValidationState, status moves and the independent-check rule are decided before Evidence's internal mutators run; depends on all five reference catalogues directly, repeating GovernedBracketCheckService's accepted shape."}, {"id": "docs_adr_adr_0148_evidence_is_a_canonical_kind_specialising_the_lifecycle_and_citing_governed_reference_data_refusal_as_result", "label": "Refusal as Result, Never an Exception", "file_type": "rationale", "source_file": "docs/adr/ADR-0148-evidence-is-a-canonical-kind-specialising-the-lifecycle-and-citing-governed-reference-data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A governed act reports a refusal enum (EvidenceRefusal) in a result type rather than throwing \u2014 GovernedBracketCheckService's precedent, so a caller never writes try/catch around an ordinary business rule."}, {"id": "docs_adr_adr_0148_evidence_is_a_canonical_kind_specialising_the_lifecycle_and_citing_governed_reference_data_independent_check_rule", "label": "Independent-Check Rule", "file_type": "rationale", "source_file": "docs