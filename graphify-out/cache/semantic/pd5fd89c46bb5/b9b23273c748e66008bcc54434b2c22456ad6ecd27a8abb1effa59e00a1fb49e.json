{"nodes": [{"id": "docs_adr_adr_0155_project_health_is_the_engineering_cockpit_s_health_rollup_scoped_to_a_project_adr_0155", "label": "ADR-0155", "file_type": "document", "source_file": "docs/adr/ADR-0155-project-health-is-the-engineering-cockpit-s-health-rollup-scoped-to-a-project.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Project health is the Engineering Cockpit's health rollup scoped to a project: a read model (ProjectHealthReadModel) over each discipline read-model's ScopedTo view, with membership resolved once per prime through ProjectMembership; RAG is EngineeringHealthStatus, no second enum; exported in programme.json v2."}, {"id": "docs_adr_adr_0155_project_health_is_the_engineering_cockpit_s_health_rollup_scoped_to_a_project_engineeringhealthstatus", "label": "EngineeringHealthStatus", "file_type": "code", "source_file": "docs/adr/ADR-0155-project-health-is-the-engineering-cockpit-s-health-rollup-scoped-to-a-project.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unknown/Healthy/Attention/Blocked \u2014 already the platform's RAG, coloured grey/green/amber/red by HealthColors and exported lower-cased."}, {"id": "docs_adr_adr_0155_project_health_is_the_engineering_cockpit_s_health_rollup_scoped_to_a_project_projecthealthreadmodel", "label": "ProjectHealthReadModel", "file_type": "code", "source_file": "docs/adr/ADR-0155-project-health-is-the-engineering-cockpit-s-health-rollup-scoped-to-a-project.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An ADR-0103 collaborator constructed by EngineeringCockpit, loaded last in PrimeAsync; one CockpitProjectHealth per live Project."}, {"id": "docs_adr_adr_0155_project_health_is_the_engineering_cockpit_s_health_rollup_scoped_to_a_project_engineeringcockpit", "label": "EngineeringCockpit", "file_type": "code", "source_file": "docs/adr/ADR-0155-project-health-is-the-engineering-cockpit-s-health-rollup-scoped-to-a-project.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WP 8.1C's workspace-wide health dashboard; its 'Project' meant the whole workspace until this ADR; declared redundant by ADR-0163."}, {"id": "docs_adr_adr_0155_project_health_is_the_engineering_cockpit_s_health_rollup_scoped_to_a_project_engineeringhealthrollup", "label": "EngineeringHealthRollup", "file_type": "code", "source_file": "docs/adr/ADR-0155-project-health-is-the-engineering-cockpit-s-health-rollup-scoped-to-a-project.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The rollup, score wording and overdue rule stated once; workspace and per-project figures call it and can differ only in scope."}, {"id": "docs_adr_adr_0155_project_health_is_the_engineering_cockpit_s_health_rollup_scoped_to_a_project_projectmembership", "label": "ProjectMembership", "file_type": "code", "source_file": "docs/adr/ADR-0155-project-health-is-the-engineering-cockpit-s-health-rollup-scoped-to-a-project.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ResolveOwningProjectAsync walks the structural parent chain to the owning Project; a requirement belongs by ProjectRequirementRegister's rule; one in-memory walk per candidate object, no projectId column."}, {"id": "docs_adr_adr_0155_project_health_is_the_engineering_cockpit_s_health_rollup_scoped_to_a_project_cockpitreadmodel_scopedto", "label": "*CockpitReadModel.ScopedTo", "file_type": "code", "source_file": "docs/adr/ADR-0155-project-health-is-the-engineering-cockpit-s-health-rollup-scoped-to-a-project.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same read-model class over a filtered copy of already-loaded data \u2014 no second load, no second rule."}, {"id": "docs_adr_adr_0155_project_health_is_the_engineering_cockpit_s_health_rollup_scoped_to_a_project_health_is_a_read_model", "label": "Project Health Is a Read Model, Never Stored", "file_type": "rationale", "source_file": "docs/adr/ADR-0155-project-health-is-the-engineering-cockpit-s-health-rollup-scoped-to-a-project.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A stored health field or projectId column would be derivable state that drifts from the objects it summarises; re-loading per project would mean N\u00d7 I/O and two loads that can disagree."}, {"id": "docs_adr_adr_0155_project_health_is_the_engineering_cockpit_s_health_rollup_scoped_to_a_project_programme_json_v2", "label": "programme.json Schema v2", "file_type": "concept", "source_file": "docs/adr/ADR-0155-project-health-is-the-engineering-cockpit-s-health-rollup-scoped-to-a-project.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "projects[].health (overall, byDiscipline, score), blockedCount, overdueActionCount, summary.byHealth, later projects[].tasks[] and summary.tasks \u2014 every v1 key unchanged."}, {"id": "docs_adr_adr_0155_project_health_is_the_engineering_cockpit_s_health_rollup_scoped_to_a_project_programmehierarchyexportadapter", "label": "ProgrammeHierarchyExportAdapter", "file_type": "code", "source_file": "docs/adr/ADR-0155-project-health-is-the-engineering-cockpit-s-health-rollup-scoped-to-a-project.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Now reads a headless EngineeringCockpit exactly as EngineeringStatusExportAdapter does, so the Pi renders what the desktop computes."}], "edges": [{"source": "docs_adr_adr_0155_project_health_is_the_engineering_cockpit_s_health_rollup_s