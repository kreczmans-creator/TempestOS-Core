{"nodes": [{"id": "docs_security_security_roadmap_security_roadmap", "label": "TempestOS Security Roadmap", "file_type": "document", "source_file": "docs/security/Security Roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prioritised future security work from Platform Security Review v0.5.0, each item tied to the Threat Model assumption that first makes it necessary; superseded for v1.0 by Security Posture.md and kept as history."}, {"id": "docs_security_security_roadmap_security_posture", "label": "Security Posture.md", "file_type": "document", "source_file": "docs/security/Security Roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_security_security_roadmap_trigger_based_security_work", "label": "Trigger-Based Security Work (Security Principle 7)", "file_type": "rationale", "source_file": "docs/security/Security Roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing is scheduled against a date; each item names the capability whose arrival makes it a prerequisite, so security machinery is designed before, not after, the capability ships \u2014 and never built ahead of a real, demonstrated need."}, {"id": "docs_security_security_roadmap_plugin_isolation_boundary", "label": "Plugin Isolation Boundary (Item 1)", "file_type": "concept", "source_file": "docs/security/Security Roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SEC-01/TD-09; resolved by ADR-0110 (capability-scoped enforcement plus code-signing trust tier, AssemblyLoadContext and process separation alone rejected, RD-0053\u20130056) and implemented in WP 13.2A fail-closed (Plugins:AllowUnsignedLoad false)."}, {"id": "docs_security_security_roadmap_navigation_ownership", "label": "Navigation Ownership (Item 2)", "file_type": "concept", "source_file": "docs/security/Security Roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NAV-1/TD-10; ADR-0111's ICurrentComponentAccessor captures the registering component at Register so Unregister rejects a mismatch unless navigation.unregister.any is held."}, {"id": "docs_security_security_roadmap_secrets_redaction_convention", "label": "Secrets-Redaction Logging Convention (Item 3)", "file_type": "concept", "source_file": "docs/security/Security Roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SEC-02: design a marker attribute, wrapper type or ILogSink filter before the platform's first real secret, because retrofitting risks a call site that logs one in plaintext."}, {"id": "docs_security_security_roadmap_project_data_security_design", "label": "Project-Data Security Design (Item 4)", "file_type": "concept", "source_file": "docs/security/Security Roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FS-1/FS-2: encryption at rest, access control and audit for classified/export-controlled fields when the dormant JsonProjectRepository subsystem is revived or replaced."}, {"id": "docs_security_security_roadmap_multi_user_tenant_isolation_decision", "label": "Multi-User / Tenant Isolation Decision (Item 5)", "file_type": "concept", "source_file": "docs/security/Security Roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FR-1: the DI container has no Scoped lifetime; decide with its own ADR between per-user OS processes and a genuine Scoped lifetime before multi-user support."}, {"id": "docs_security_security_roadmap_authentication_and_authorisation_design", "label": "Authentication and Authorisation Design (Item 6)", "file_type": "concept", "source_file": "docs/security/Security Roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_security_security_roadmap_api_and_networking_exposure", "label": "API and Networking Exposure (Item 7)", "file_type": "concept", "source_file": "docs/security/Security Roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Threat-model any first socket on its own terms: authentication, transport security, input validation at the boundary, rate limiting."}, {"id": "docs_security_security_roadmap_licensing_item", "label": "Licensing (Item 8)", "file_type": "concept", "source_file": "docs/security/Security Roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_security_security_roadmap_offline_sync_and_mobile", "label": "Offline Synchronisation and Mobile Devices (Item 9)", "file_type": "concept", "source_file": "docs/security/Security Roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_security_security_roadmap_command_and_navigation_id_ownership", "label": "Command and Navigation Id Ownership/Priority Model (Item 10)", "file_type": "concept", "source_file": "docs/security/Security Roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CMD-1/TD-11: first-registration-wins let an earlier-sorting plugin claim a well-known Id; ADR-0111 chose trust-tier priority over an Id-namespace prefix (RD-0059), implemented in NavigationService.Register, CommandHandlerTable.Register and CommandRegistry.RegisterDescriptor with a loud ownership-override warning."}, {"id": "docs_security_security_roadmap_threat_model", "label": "Threat Model.md", "file_type": "document", "source_file": "docs/s