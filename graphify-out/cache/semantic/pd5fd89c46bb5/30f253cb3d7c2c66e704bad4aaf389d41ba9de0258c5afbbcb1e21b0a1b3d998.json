tor": null, "rationale": "No existing record's persisted shape changes; links, outbox entries and the cached settings reading are new schema-versioned stores; a pre-v0.24.0 invoice request sent to Xero is imported as a link on first read."}, {"id": "docs_adr_adr_0162_xero_holds_drafts_and_copies_tempestos_never_approves_or_sends_and_every_push_goes_through_one_durable_idempotent_outbox_xero_badge", "label": "Xero Badge", "file_type": "concept", "source_file": "docs/adr/ADR-0162-xero-holds-drafts-and-copies-tempestos-never-approves-or-sends-and-every-push-goes-through-one-durable-idempotent-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not sent, Queued, In Xero (draft), In Xero, Awaiting payment, Paid, Voided, Failed with reason and Retry, Needs re-authorising."}], "edges": [{"source": "docs_adr_adr_0162_xero_holds_drafts_and_copies_tempestos_never_approves_or_sends_and_every_push_goes_through_one_durable_idempotent_outbox_adr_0162", "target": "docs_adr_adr_0151_the_connector_seam_is_a_result_never_an_exception_the_requests_own_id_is_the_idempotency_key_paid_is_read_never_set_adr_0151", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-0162-xero-holds-drafts-and-copies-tempestos-never-approves-or-sends-and-every-push-goes-through-one-durable-idempotent-outbox.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_0162_xero_holds_drafts_and_copies_tempestos_never_approves_or_sends_and_every_push_goes_through_one_durable_idempotent_outbox_adr_0162", "target": "docs_adr_adr_0152_a_quotation_opened_with_the_project_defines_its_deliverables_and_initial_requirements_adr_0152", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-0162-xero-holds-drafts-and-copies-tempestos-never-approves-or-sends-and-every-push-goes-through-one-durable-idempotent-outbox.md", "source_location": 