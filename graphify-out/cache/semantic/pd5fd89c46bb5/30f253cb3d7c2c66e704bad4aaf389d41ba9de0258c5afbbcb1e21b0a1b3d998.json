{"nodes": [{"id": "docs_adr_adr_0162_xero_holds_drafts_and_copies_tempestos_never_approves_or_sends_and_every_push_goes_through_one_durable_idempotent_outbox_adr_0162", "label": "ADR-0162", "file_type": "document", "source_file": "docs/adr/ADR-0162-xero-holds-drafts-and-copies-tempestos-never-approves-or-sends-and-every-push-goes-through-one-durable-idempotent-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Xero masters everything that reaches the accounts (read and cached); TempestOS masters quotes, invoices, purchase orders and expenses and copies them to Xero as DRAFT with the same number and PDF; TempestOS never approves, sends or writes payments, enforced by XeroWriteSafetyHandler and simulator/architecture tests; every write goes through one durable idempotent outbox; Demo Company only until an audited Allow-live switch."}, {"id": "docs_adr_adr_0162_xero_holds_drafts_and_copies_tempestos_never_approves_or_sends_and_every_push_goes_through_one_durable_idempotent_outbox_xero_source_of_truth_split", "label": "Source of Truth: Xero Masters Accounts, TempestOS Masters Commercial Work", "file_type": "rationale", "source_file": "docs/adr/ADR-0162-xero-holds-drafts-and-copies-tempestos-never-approves-or-sends-and-every-push-goes-through-one-durable-idempotent-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "D1\u2013D7: company details, VAT, bank details, tax rates, chart of accounts, contact billing details and payment status are read from Xero (cached with time read so PDFs and validation work offline); quotes, revisions, acceptance, invoice content and number, purchase orders and expenses are mastered here and copied."}, {"id": "docs_adr_adr_0162_xero_holds_drafts_and_copies_tempestos_never_approves_or_sends_and_every_push_goes_through_one_durable_idempotent_outbox_drafts_and_copies_only", "label": "Drafts and Copies Only (D3, D4)", "file_type": "rationale", "source_file": "docs/adr/ADR-0162-xero-holds-drafts-and-copies-tempestos-never-approves-or-sends-and-every-push-goes-through-one-durable-idempotent-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never SUBMITTED or AUTHORISED, never SentToContact, never an email endpoint, never payments, bank transactions, journals, credit notes, the organisation, tax rates or accounts; a Xero quote moves only DRAFT \u2192 SENT \u2192 ACCEPTED | DECLINED following TempestOS. Revisiting D3/D4 is a new ADR, not a setting."}, {"id": "docs_adr_adr_0162_xero_holds_drafts_and_copies_tempestos_never_approves_or_sends_and_every_push_goes_through_one_durable_idempotent_outbox_xerowritesafetyhandler", "label": "XeroWriteSafetyHandler", "file_type": "code", "source_file": "docs/adr/ADR-0162-xero-holds-drafts-and-copies-tempestos-never-approves-or-sends-and-every-push-goes-through-one-durable-idempotent-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A DelegatingHandler in the Xero HttpClient refusing a forbidden request before it leaves the machine; contacts are on its write allow-list; the Demo Company rule applies there too."}, {"id": "docs_adr_adr_0162_xero_holds_drafts_and_copies_tempestos_never_approves_or_sends_and_every_push_goes_through_one_durable_idempotent_outbox_demo_company_first", "label": "Demo Company First (D7)", "file_type": "rationale", "source_file": "docs/adr/ADR-0162-xero-holds-drafts-and-copies-tempestos-never-approves-or-sends-and-every-push-goes-through-one-durable-idempotent-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TempestOS writes only to an organisation Xero reports IsDemoCompany until the Product Owner turns on Allow the live organisation in Settings (audited); links are scoped to one organisation so Demo Company ids are never used against the live one."}, {"id": "docs_adr_adr_0162_xero_holds_drafts_and_copies_tempestos_never_approves_or_sends_and_every_push_goes_through_one_durable_idempotent_outbox_xero_outbox", "label": "One Durable, Idempotent Outbox", "file_type": "rationale", "source_file": "docs/adr/ADR-0162-xero-holds-drafts-and-copies-tempestos-never-approves-or-sends-and-every-push-goes-through-one-durable-idempotent-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persisted entries planned from each record's desired state after every committed change and at start-up, drained one at a time honouring 429 Retry-After and backoff, pausing for re-authorisation, audited; a create is never issued while a link exists, carries a fixed Idempotency-Key, and a lost response is reconciled by number before anything is resent."}, {"id": "docs_adr_adr_0162_xero_holds_drafts_and_copies_tempestos_never_approves_or_sends_and_every_push_goes_through_one_durable_idempotent_outbox_xerocontactlinker", "label": "XeroContactLinker", "file_type": "code", "source_file": "docs/adr/ADR-0162-xero-holds-drafts-and-copies-tempestos-never-approves-or-sends-and-every-push-goes-through-one-durable-idempotent-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Amendment m10: Create in Xero and the Q7 ContactNumber write are sent at once, not queued, because both are the person's own act in an open prompt that needs Xero's answer; idempotent without the outbox by lookup-first, fixed key and re-send of the same body."}, {"id": "docs_adr_adr_0162_xero_holds_drafts_and_copies_tempestos_never_approves_or_sends_and_every_push_goes_through_one_durable_idempotent_outbox_contacts_linked_by_contactid", "label": "Contacts Linked by ContactID, Never Matched Silently by Name", "file_type": "rationale", "source_file": "docs/adr/ADR-0162-xero-holds-drafts-and-copies-tempestos-never-approves-or-sends-and-every-push-goes-through-one-durable-idempotent-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Review item M21: the old {\"Name\": \u2026} contact let Xero create a contact silently; an unlinked client is now refused before anything is sent."}, {"id": "docs_adr_adr_0162_xero_holds_drafts_and_copies_tempestos_never_approves_or_sends_and_every_push_goes_through_one_durable_idempotent_outbox_minimal_granular_scopes", "label": "Minimal Granular Scopes", "file_type": "concept", "source_file": "docs/adr/ADR-0162-xero-holds-drafts-and-copies-tempestos-never-approves-or-sends-and-every-push-goes-through-one-durable-idempotent-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "accounting.invoices, accounting.contacts, accounting.settings.read, accounting.attachments, accounting.reports.banksummary.read, offline_access; Xero apps created from 2 March 2026 can only use granular scopes; re-authorisation is requested when the stored grant lacks one."}, {"id": "docs_adr_adr_0162_xero_holds_drafts_and_copies_tempestos_never_approves_or_sends_and_every_push_goes_through_one_durable_idempotent_outbox_in_process_xero_simulator", "label": "In-Process Xero Simulator", "file_type": "code", "source_file": "docs/adr/ADR-0162-xero-holds-drafts-and-copies-tempestos-never-approves-or-sends-and-every-push-goes-through-one-durable-idempotent-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Independently records any D3/D4 violation on every end-to-end test; every Xero path is tested without network."}, {"id": "docs_adr_adr_0162_xero_holds_drafts_and_copies_tempestos_never_approves_or_sends_and_every_push_goes_through_one_durable_idempotent_outbox_xero_demo_smoke_ps1", "label": "scripts/xero-demo-smoke.ps1", "file_type": "code", "source_file": "docs/adr/ADR-0162-xero-holds-drafts-and-copies-tempestos-never-approves-or-sends-and-every-push-goes-through-one-durable-idempotent-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Category=XeroLive operator-run smoke test against the Demo Company only; skipped in CI; also drives the production path since the review board."}, {"id": "docs_adr_adr_0162_xero_holds_drafts_and_copies_tempestos_never_approves_or_sends_and_every_push_goes_through_one_durable_idempotent_outbox_po_decisions_d1_d7", "label": "Product Owner Decisions D1\u2013D7 (2026-10-02)", "file_type": "concept", "source_file": "docs/adr/ADR-0162-xero-holds-drafts-and-copies-tempestos-never-approves-or-sends-and-every-push-goes-through-one-durable-idempotent-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_0162_xero_holds_drafts_and_copies_tempestos_never_approves_or_sends_and_every_push_goes_through_one_durable_idempotent_outbox_xero_integration_plan", "label": "Xero Integration Plan.md", "file_type": "document", "source_file": "docs/adr/ADR-0162-xero-holds-drafts-and-copies-tempestos-never-approves-or-sends-and-every-push-goes-through-one-durable-idempotent-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_0162_xero_holds_drafts_and_copies_tempestos_never_approves_or_sends_and_every_push_goes_through_one_durable_idempotent_outbox_xero_technical_design", "label": "Xero Technical Design.md", "file_type": "document", "source_file": "docs/adr/ADR-0162-xero-holds-drafts-and-copies-tempestos-never-approves-or-sends-and-every-push-goes-through-one-durable-idempotent-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": 