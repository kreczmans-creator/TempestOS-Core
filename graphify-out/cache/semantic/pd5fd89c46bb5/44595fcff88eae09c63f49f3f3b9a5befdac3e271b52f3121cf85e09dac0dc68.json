{"nodes": [{"id": "docs_academy_06_engineering_standards_engineering_governance_tempestos_engineering_governance", "label": "TempestOS Engineering Governance", "file_type": "document", "source_file": "docs/academy/06 Engineering Standards/Engineering Governance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_academy_06_engineering_standards_engineering_governance_normative_status", "label": "Normative Status", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/Engineering Governance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "This document governs where any other conflicts, unless explicitly superseded; it codifies practice already exercised, nothing aspirational."}, {"id": "docs_academy_06_engineering_standards_engineering_governance_contributing_md_governs", "label": "CONTRIBUTING.md Governs", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/Engineering Governance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WP 17.0B governance reset replaced retrospectives, readiness reviews, certifications and the register suite; where this document and CONTRIBUTING.md differ, CONTRIBUTING.md governs."}, {"id": "docs_academy_06_engineering_standards_engineering_governance_work_package_lifecycle", "label": "Work Package Lifecycle", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/Engineering Governance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brief issued, scope confirmed before code, dedicated branch never main, continuous validation, completion report, Technical Review, commits, explicit merge approval: complete and merged are two distinct events."}, {"id": "docs_academy_06_engineering_standards_engineering_governance_commit_structure", "label": "Commit Structure", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/Engineering Governance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One cohesive unit is one commit titled to match the Work Package; never amend once pushed; destructive git operations need explicit approval."}, {"id": "docs_academy_06_engineering_standards_engineering_governance_review_gates", "label": "Review Gates", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/Engineering Governance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build Gate, Test Gate, Technical Review Gate (a written justification, not necessarily a change), Merge/Release Gate."}, {"id": "docs_academy_06_engineering_standards_engineering_governance_technical_review_gate", "label": "Technical Review Gate", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/Engineering Governance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ask the specific falsifiable question, request the reasoning not an immediate code change; if the reasoning holds, accept it and record why. WP 2.3 Dispose-precondition exchange is the model."}, {"id": "docs_academy_06_engineering_standards_engineering_governance_definition_of_done", "label": "Definition of Done", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/Engineering Governance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gates pass from a clean committed tree, no TODOs or dead code, XML docs, completion report, ADRs, Rejected Designs entries, Academy updated, unrelated issues documented and fixed only if blocking, work stays on its branch until approval."}, {"id": "docs_academy_06_engineering_standards_engineering_governance_completion_report_requirements", "label": "Completion Report Requirements", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/Engineering Governance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nine mandatory sections including pass/fail counts and warning counts, not merely tests pass or it builds; the floor not the ceiling."}, {"id": "docs_academy_06_engineering_standards_engineering_governance_adr_creation_rules", "label": "ADR Creation Rules", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/Engineering Governance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Required when a genuine alternative was rejected, reversal would be expensive, a convention is established, an ambiguity is resolved, or a decision was challenged under review; numbers never reused."}, {"id": "docs_academy_06_engineering_standards_engineering_governance_academy_maintenance", "label": "Academy Maintenance", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/Engineering Governance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A maintained asset not a one-time deliverable; Future Evolution sections updated when the predicted change happens; every case study has a matching ADR; Platform Service Map maintained under the same obligation."}, {"id": "docs_academy_06_engineering_standards_engineering_governance_release_approval_process", "label": "Release Approval Process", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/Engineering Governance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cut only from main, VERSION matched by release notes, gates pass on main itself, annotated tag created once and never moved, every push and merge needs per-occasion approval, every merge via pull request as a merge commit."}, {"id": "docs_academy_06_engineering_standards_engineering_governance_immutable_tag_narrow_exception", "label": "Immutable Tag Narrow Exception", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/Engineering Governance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WP 11.4B: a published tag may be corrected only for a documented release-process defect found before the release branch closes, with Product Owner approval and a correction report."}, {"id": "docs_academy_06_engineering_standards_engineering_governance_coding_standards_hierarchy", "label": "Coding Standards Hierarchy", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/Engineering Governance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brief, then this document, then Engineering Standards, then established codebase convention, then general principle; a same-level conflict is Technical Review material."}, {"id": "docs_academy_06_engineering_standards_engineering_governance_decision_authority_three_tiers", "label": "Decision Authority Three Tiers", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/Engineering Governance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Architecture (internal design within the brief, always documented), Technical Review (sufficient answer not necessarily a change), Product Approval (whether work ships). No tier substitutes for another."}, {"id": "docs_academy_06_engineering_standards_engineering_governance_rejected_designs_log", 