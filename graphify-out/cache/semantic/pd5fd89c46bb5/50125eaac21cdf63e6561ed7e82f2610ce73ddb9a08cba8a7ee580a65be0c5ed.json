{"nodes": [{"id": "docs_adr_adr_0159_shipped_reference_data_is_released_at_seed_under_a_named_seed_identity_and_a_record_s_visible_revision_is_its_content_revision_adr_0159", "label": "ADR-0159", "file_type": "document", "source_file": "docs/adr/ADR-0159-shipped-reference-data-is-released-at-seed-under-a-named-seed-identity-and-a-record-s-visible-revision-is-its-content-revision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The five shipped reference libraries are verified and released at seed through the ordinary ReferenceReviewService path under the named non-human identity tempest.reference-seed; only untouched shipped records are refreshed; a record has two revision numbers \u2014 RevisionNumber (stored stamp pins cite) and ContentRevision (what a person sees)."}, {"id": "docs_adr_adr_0159_shipped_reference_data_is_released_at_seed_under_a_named_seed_identity_and_a_record_s_visible_revision_is_its_content_revision_referenceseedreleasepolicy", "label": "ReferenceSeedReleasePolicy", "file_type": "code", "source_file": "docs/adr/ADR-0159-shipped-reference-data-is-released-at-seed-under-a-named-seed-identity-and-a-record-s-visible-revision-is-its-content-revision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Registered in TempestHost; a policy the host carries, not a default of the seeding mechanism \u2014 constructed without it the service seeds Draft as before."}, {"id": "docs_adr_adr_0159_shipped_reference_data_is_released_at_seed_under_a_named_seed_identity_and_a_record_s_visible_revision_is_its_content_revision_referenceseedservice", "label": "ReferenceSeedService", "file_type": "code", "source_file": "docs/adr/ADR-0159-shipped-reference-data-is-released-at-seed-under-a-named-seed-identity-and-a-record-s-visible-revision-is-its-content-revision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applies the policy for datasets marked IReferenceSeed<T>.ReleaseAtSeed; ApplyAtStartupAsync leaves a library holding any person-owned record alone."}, {"id": "docs_adr_adr_0159_shipped_reference_data_is_released_at_seed_under_a_named_seed_identity_and_a_record_s_visible_revision_is_its_content_revision_referencereviewservice", "label": "ReferenceReviewService", "file_type": "code", "source_file": "docs/adr/ADR-0159-shipped-reference-data-is-released-at-seed-under-a-named-seed-identity-and-a-record-s-visible-revision-is-its-content-revision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Draft \u2192 Checked \u2192 Validated \u2192 Released with provenance checks, permission checks and audit rows; ReleaseAsync is internal so nothing outside Tempest.Core can release under the seed identity."}, {"id": "docs_adr_adr_0159_shipped_reference_data_is_released_at_seed_under_a_named_seed_identity_and_a_record_s_visible_revision_is_its_content_revision_tempest_reference_seed_identity", "label": "tempest.reference-seed", "file_type": "concept", "source_file": "docs/adr/ADR-0159-shipped-reference-data-is-released-at-seed-under-a-named-seed-identity-and-a-record-s-visible-revision-is-its-content-revision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named non-human seed identity holding exactly verify and release permissions; audit actor and revision author for the whole releasing pass, so a signed-in person is never recorded as having verified shipped data."}, {"id": "docs_adr_adr_0159_shipped_reference_data_is_released_at_seed_under_a_named_seed_identity_and_a_record_s_visible_revision_is_its_content_revision_currentprincipalaccessor_beginactingas", "label": "CurrentPrincipalAccessor.BeginActingAs", "file_type": "code", "source_file": "docs/adr/ADR-0159-shipped-reference-data-is-released-at-seed-under-a-named-seed-identity-and-a-record-s-visible-revision-is-its-content-revision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Async-flow-scoped override (internal to Tempest.Core) rather than the process-wide principal session, so a person pressing Populate while working never has their concurrent writes attributed to the seed."}, {"id": "docs_adr_adr_0159_shipped_reference_data_is_released_at_seed_under_a_named_seed_identity_and_a_record_s_visible_revision_is_its_content_revision_release_at_seed", "label": "Release at Seed", "file_type": "rationale", "source_file": "docs/adr/ADR-0159-shipped-reference-data-is-released-at-seed-under-a-named-seed-identity-and-a-record-s-visible-revision-is-its-content-revision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Until v0.23.0 a seeded record landed Draft and every calculator reads Released only, so a fresh install could calculate nothing; PO: fully usable from day 1 or a hard block against v1.0.0. Seeding directly as Released was rejected because it bypasses the provenance rule and review path."}, {"id": "docs_adr_adr_0159_shipped_reference_data_is_released_at_seed_under_a_named_seed_identity_and_a_record_s_visible_revision_is_its_content_revision_contentrevision", "label": "ContentRevision", "file_type": "code", "source_file": "docs/adr/ADR-0159-shipped-reference-data-is-released-at-seed-under-a-named-seed-identity-and-a-record-s-visible-revision-is-its-content-revision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1 when registered, advancing only when definition, source citation or provenance source identity changes; stored on ReferenceDocumentDto, derived from history for older content so no migration is needed. Runbook B2: a release shouldn't change the revision of the data."}, {"id": "docs_adr_adr_0159_shipped_reference_data_is_released_at_seed_under_a_named_seed_identity_and_a_record_s_visible_revision_is_its_content_revision_releaseatseed_opt_out", "label": "ReferenceData:ReleaseAtSeed=false", "file_type": "concept", "source_file": "docs/adr/ADR-0159-shipped-reference-data-is-released-at-seed-under-a-named-seed-identity-and-a-record-s-visible-revision-is-its-content-revision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The stricter choice: every shipped record lands Draft and waits for a person's review."}, {"id": "docs_adr_adr_0159_shipped_reference_data_is_released_at_seed_under_a_named_seed_identity_and_a_record_s_visible_revision_is_its_content_revision_refresh_only_untouched_records", "label": "Only Untouched Shipped Records Are Refreshed", "file_type": "rationale", "source_file": "docs/adr/ADR-0159-shipped-reference-data-is-released-at-seed-under-a-named-seed-identity-and-a-record-s-visible-revision-is-its-content-revision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A shipped record still exactly as an earlier seed left it (Draft, revision 1, not verified, same source organisation) is revised to the current dataset and released; anything a person touched is left alone."}, {"id": "docs_adr_adr_0159_shipped_reference_data_is_released_at_seed_under_a_named_seed_identity_and_a_record_s_visible_revision_is_its_content_revision_what_the_seed_check_says", "label": "What the Seed Check Says It Checked", "file_type": "rationale", "source_file": "docs/adr/ADR-0159-shipped-reference-data-is-released-at-seed-under-a-named-seed-identity-and-a-record-s-visible-revision-is-its-content-revision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The recorded statement names the cited source, says the check was against the secondary source as transcribed, not the primary standard, and that the primary must be consulted before issue."}, {"id": "docs_adr_adr_0159_shipped_reference_data_is_released_at_seed_under_a_named_seed_identity_and_a_record_s_visible_revision_is_its_content_revision_releaseatseedattributiontests", "label": "ReleaseAtSeedAttributionTests", "file_type": "code", "source_file": "docs/adr/ADR-0159-shipped-reference-data-is-released-at-seed-under-a-named-seed-identity-and-a-record-s-visible-revision-is-its-content-revision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_0159_shipped_reference_data_is_released_at_seed_under_a_named_seed_identity_and_a_record_s_visible_revision_is_its_content_revision_referencecontentrevisiontests", "label": "ReferenceContentRevisionTests", "file_type": "code", "source_file": "docs/adr/ADR-0159-shipped-reference-data-is-released-at-seed-under-a-named-seed-identity-and-a-record-s-visible-revision-is-its-content-revision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_adr_adr_0159_shipped_reference_data_is_released_at_seed_under_a_named_seed_identity_and_a_record_s_visible_revision_is_its_content_revision_adr_0159", "target": "docs_adr_adr_0149_a_reference_record_carries_a_structured_source_citation_and_supersession_keeps_every_pin_valid_adr_0149", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-0159-shipped-reference-data-is-released-at-seed-under-a-named-seed-identity-and-a-record-s-visible-revision-is-its-content-revision.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_0159_shipped_reference_data_is_released_at_seed_under_a_named_seed_identity_and_a_record_s_visible_revision_is_its_content_revision_adr_0159", "target": "docs_adr_adr_0144_persistence_is_sqlite_in_wal_mode_with_full_synchronous