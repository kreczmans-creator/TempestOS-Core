{"nodes": [{"id": "docs_academy_06_engineering_standards_06_governance_automation_engineering_standard__governance_automation", "label": "Engineering Standard: Governance Automation", "file_type": "document", "source_file": "docs/academy/06 Engineering Standards/06-governance-automation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_academy_06_engineering_standards_06_governance_automation_scripts_governance_healthcheck_ps1", "label": "scripts/governance-healthcheck.ps1", "file_type": "concept", "source_file": "docs/academy/06 Engineering Standards/06-governance-automation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_academy_06_engineering_standards_06_governance_automation_fcr_0005", "label": "FCR-0005", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/06-governance-automation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Governance Register Health-Check Tooling, rediscovered seven times across releases as registers went stale between manual audits."}, {"id": "docs_academy_06_engineering_standards_06_governance_automation_td_57", "label": "TD-57", "file_type": "concept", "source_file": "docs/academy/06 Engineering Standards/06-governance-automation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_academy_06_engineering_standards_06_governance_automation_td_43", "label": "TD-43", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/06-governance-automation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A crashing check was reported under one hard-coded label; the catch now carries check name, exception type and message so a CI Gate failure is diagnosable from the report alone."}, {"id": "docs_academy_06_engineering_standards_06_governance_automation_d_021", "label": "D-021", "file_type": "concept", "source_file": "docs/academy/06 Engineering Standards/06-governance-automation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_academy_06_engineering_standards_06_governance_automation_wp_11_2a_original_eight_checks", "label": "WP 11.2A Original Eight Checks", "file_type": "concept", "source_file": "docs/academy/06 Engineering Standards/06-governance-automation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_academy_06_engineering_standards_06_governance_automation_wp_16_1b_source_derived_checks", "label": "WP 16.1B Source-Derived Checks", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/06-governance-automation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eight more checks each derived directly from source, never from another register, because registers cross-checked against each other can drift together and never disagree."}, {"id": "docs_academy_06_engineering_standards_06_governance_automation_structural_not_prose_claims", "label": "Structural Not Prose Claims", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/06-governance-automation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The tool checks structural claims a machine can verify without ambiguity; prose accuracy still depends on a human reader, so Decision, Risk and Validation registers were deliberately not covered."}, {"id": "docs_academy_06_engineering_standards_06_governance_automation_reports_does_not_correct", "label": "Reports Does Not Correct", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/06-governance-automation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No check offers a fix; a stale register is a Work Package job to update, the tool narrows where to look and never decides correct content."}, {"id": "docs_academy_06_engineering_standards_06_governance_automation_read_only_isolated_validation", "label": "Read-Only Isolated Validation", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/06-governance-automation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never builds or references production projects, never writes inside RepoRoot; validated against a deliberately broken fixture in an isolated directory, never a mutated real repository."}, {"id": "docs_academy_06_engineering_standards_06_governance_automation_crashing_check_is_a_fail", "label": "Crashing Check Is a Fail", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/06-governance-automation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A crash is treated as Fail never a silent skip; three genuine defects were found this way."}, {"id": "docs_academy_06_engineering_standards_06_governance_automation_non_vacuousness_convention", "label": "Non-Vacuousness Convention", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/06-governance-automation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every check is proven by breaking the tracked governance document on purpose, observing the specific Fail, and restoring with git checkout."}, {"id": "docs_academy_06_engineering_standards_06_governance_automation_bom_blind_spot_finding", "label": "BOM Blind Spot Finding", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/06-governance-automation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ProjectModel.cs opens with a UTF-8 BOM that breaks the anchored ^namespace grep the register documents as source of truth; Get-Content -Raw strips the BOM and sees the real namespace."}, {"id": "docs_academy_06_engineering_standards_06_governance_automation_td_register_summary_stale_finding", "label": "TD Register Summary Stale Finding", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/06-governance-automation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Summary line off by one in both directions because a sibling branch resolved TD-116 after the branch point; a branch-topology artefact, not arithmetic error."}, {"id": "docs_academy_06_engineering_standards_06_governance_automation_health_check_reduced_to_five", "label": "Health Check Reduced to Five", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/06-governance-automation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WP 17.0B cut sixteen checks to five source-derived checks plus the Markdown budget once the registers it audited were archived."}, {"id": "docs_academy_06_engineering_standards_06_governance_automation_academy_index_stale_finding", "label": "Academy Index Stale Finding", "file_type": "concept", "source_file": "docs/academy/06 Engineering Standards/06-governance-automation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_academy_06_engineering_standards_06_governance_automation_empty_directory_finding", "label": "Empty Directory Finding", "file_type": "rationale", "source_file": "docs/academy/06 Engineering Standards/06-governance-automation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Git cannot track an empty directory, so registers described directories not present in the tree."}], "edges": [{"source": "docs_academy_06_engineering_standards_06_governance_automation_engineering_standard__governance_automation", "target": "docs_academy_06_engineering_standards_06_governance_automation_scripts_governance_healthcheck_ps1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/academy/06 Engineering Standards/06-governance-automation.md", "source_location": null, "weight": 1.0}, {"source": "docs_academy_06_engineering_standards_06_governance_automation_engineering_standard__governance_automation", "target": "docs_academy_06_engineering_standards_04_continuous_integration__github_workflows_ci_yml", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/academy/06 Engineering Standards/06-governance-automation.md", "source_location": null, "weight": 1.0}, {"source": "docs_academy_06_engineering_standards_06_governance_automation_engineering_standard__governance_automation", "target": "docs_academy_06_engineering_standards_04_continuous_integration_ci_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/academy/06 Engineering Standards/06-governance-automation.md", "source_location": null, "weight": 1.0}, {"source": "docs_academy_06_engineering_standards_06_governance_automation_engineering_standard__governance_automation", "target": "docs_academy_06_engineering_standards_08_the_physical_review_and_the_release_gate_the_physical_review_and_the_release_gate", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/academy/06 Engineering Standards/06-governance-automation.md", "source_location": null, "weight": 1.0}, {"source":