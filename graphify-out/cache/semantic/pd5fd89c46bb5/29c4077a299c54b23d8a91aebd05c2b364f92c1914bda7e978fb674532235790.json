 null, "weight": 1.0}, {"source": "_github_workflows_ci_linux_launch_smoke", "target": "physical_review_td_116", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_ci_ci", "target": "readme_security_posture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_ci_ci", "target": "backlog_wp_17_0b", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "ci_gate_required_jobs", "label": "CI Gate and the three jobs it requires", "nodes": ["_github_workflows_ci_gate", "_github_workflows_ci_build_and_test", "_github_workflows_ci_governance_health_check", "_github_workflows_ci_dependency_scan"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml"}]}