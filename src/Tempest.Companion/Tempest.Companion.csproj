<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      WP 14.0A: TempestOS Companion - the mobile operational interface to
      the TempestOS platform (ADR-0113). Same UI framework as
      Tempest.Desktop (Avalonia, ADR-0094), same authoring style (every
      View constructed directly in C#, no .axaml), same test strategy
      (Avalonia.Headless.XUnit). Since WP 14.2A (ADR-0116) this is the
      SHARED single-view application library - the official Avalonia
      cross-platform shape: every screen, service, theme, and the App
      class live here, and each platform head
      (Tempest.Companion.Desktop's phone-frame window,
      Tempest.Companion.Android, Tempest.Companion.iOS) is a thin
      bootstrap over it.
      Talks to the platform ONLY over the REST API boundary (ADR-0114) -
      no reference to Tempest.Core, Tempest.App, or any Domain type:
      a separate process, exactly like a real phone would be.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <!-- Inter - the brand's prose typeface - ships embedded in this official Avalonia package; Chakra Petch and Space Mono are embedded below under their own OFL licences (Assets/Fonts/OFL-*.txt). -->
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tempest.Companion.Contracts\Tempest.Companion.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
