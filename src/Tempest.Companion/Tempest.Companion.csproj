<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      WP 14.0A: TempestOS Companion - the mobile operational interface to
      the TempestOS platform (ADR-0113). Same UI framework as
      Tempest.Desktop (Avalonia, ADR-0094), same authoring style (every
      View constructed directly in C#, no .axaml), same test strategy
      (Avalonia.Headless.XUnit). The application itself is a single-view
      mobile shell (ISingleViewApplicationLifetime-ready); this project's
      own desktop lifetime hosts that shell in a phone-frame window - the
      runnable form until Android/iOS platform heads are added (TD-57,
      mobile workloads unavailable in the build environment).
      Talks to the platform ONLY over the REST API boundary (ADR-0114) -
      no reference to Tempest.Core, Tempest.App, or any Domain type:
      a separate process, exactly like a real phone would be.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <!-- Inter - the TempestOS body/UI typeface - ships embedded in this official Avalonia package; Chakra Petch and Space Mono are embedded below under their own OFL licences (Assets/Fonts/OFL-*.txt). -->
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <!-- Same advisory pin Tempest.Desktop already carries for Avalonia.Desktop's transitive Tmds.DBus.Protocol (GHSA-xrw6-gwf8-vvr9). -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tempest.Companion.Contracts\Tempest.Companion.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
