<Project Sdk="Microsoft.NET.Sdk">

  <!-- ADR-0165 / D-01: the transparent worksheet engine. Depends on nothing
       but the BCL, deliberately: it can be lifted out of this repository
       unchanged. Unit-aware expression evaluation over a runtime SI
       dimension vector, structured step recording, resource caps. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tempest.Calc.Engine</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tempest.Calc.Tests.Engine" />
  </ItemGroup>

</Project>
