<Project Sdk="Microsoft.NET.Sdk">

  <!-- ADR-0165 / D-06: the only Tempest.Calc assembly that depends on
       Core. The catalogue of calculators, the CalcInstance store, the
       one-transaction Issue into Evidence, the Calculation-register link,
       packs and the stale marker. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tempest.Calc.Library</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tempest.Calc.Verification\Tempest.Calc.Verification.csproj" />
    <ProjectReference Include="..\Tempest.Calc.Import\Tempest.Calc.Import.csproj" />
    <ProjectReference Include="..\..\Tempest.Core\Tempest.Core.csproj" />
  </ItemGroup>

  <!-- Addendum C, C-4: the document-derived data of the verification dashboard, made by scripts/generate-verification-snapshot.py. -->
  <!-- Addendum C, C-5: the guided test script, generated by scripts/generate-guided-test-script.py and embedded because the docs folder is not in an installed build. -->
  <!-- ADR-0177 / DC-14: the content hash of every template version ever recorded, embedded from where TemplateVersionManifestTests keeps it
       complete and add-only (the test writes it there with TEMPEST_UPDATE_TEMPLATE_MANIFEST=1), so a superseded version can still be named and resolved. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\tests\Tempest.Calc.Tests.Library\TemplateVersionManifest.json" Link="TemplateVersionManifest.json" LogicalName="Tempest.Calc.Library.TemplateVersionManifest.json" />
    <EmbeddedResource Include="Dashboard\verification-snapshot.json" />
    <EmbeddedResource Include="ManualTesting\guided-test-script.json" LogicalName="Tempest.Calc.Library.ManualTesting.guided-test-script.json" />
  </ItemGroup>

  <!-- Owner decision 2026-10-29 (comment 5): the bundled reference records, one Track P template CSV per set; RecordSeeds/RecordSeedCatalogue.cs holds their sources and licence status. -->
  <ItemGroup>
    <EmbeddedResource Include="RecordSeeds\Data\*.csv" LogicalName="Tempest.Calc.Library.RecordSeeds.Data.%(Filename).csv" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tempest.Calc.Tests.Library" />
  </ItemGroup>

</Project>
