<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Tempest.Core\Tempest.Core.csproj" />
    <!--
      Tempest.Core only. `TD-75` phase 2 removed the Tempest.Samples
      reference: DuplicateNavigationModule used to read one constant from a
      sample module to collide with, which meant the sample harness could not
      be deleted without breaking this one. It now collides with whatever
      INavigationProvider.Items already holds, so this project depends on no
      sample content at all. See "Fault Injection & Validation
      Architecture.md" and the Architectural Dependency Register.
    -->
  </ItemGroup>

</Project>
