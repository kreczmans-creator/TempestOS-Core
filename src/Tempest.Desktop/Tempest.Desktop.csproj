<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      WP 10.0B: this platform's first-ever GUI framework dependency
      (ADR-0094). No .axaml markup files are used anywhere in this project —
      every View is constructed directly in C#, a deliberate, disclosed
      choice (see WP10.0B Implementation Report.md) that keeps this Work
      Package's own first Avalonia integration on one build pipeline
      (the ordinary C# compiler) rather than two (C# plus Avalonia's own
      separate XAML compiler), while remaining fully idiomatic Avalonia —
      the framework supports pure-code UI construction as a first-class
      authoring style, not a workaround.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <!--
      WP 16.5B (TD-116): Avalonia.Desktop 11.3.x transitively pulls
      Avalonia.FreeDesktop 11.3.x (its own Linux X11/DBus clipboard and IME
      integration), which itself depends on Tmds.DBus.Protocol >= 0.21.3.
      That floor is deliberate, not incidental: 0.21.3 is where advisory
      GHSA-xrw6-gwf8-vvr9 (the same high-severity Tmds.DBus.Protocol
      vulnerability originally remediated here) was backported-fixed on the
      pre-rewrite 0.2x API line — the line Avalonia.FreeDesktop's compiled
      IL still binds against by member layout. Pinned here at exactly that
      floor, the lowest version that is both patched and binary-compatible.
      The previous pin, 0.94.2, is also patched but sits on the 0.9x line,
      a full API rewrite (new type layout, member signatures) that broke at
      runtime with `System.TypeLoadException: Could not load type
      'Tmds.DBus.Protocol.Connection'` inside
      `Avalonia.FreeDesktop.DBusIme.X11DBusImeHelper.DetectAndRegister()`
      during `AvaloniaX11Platform.Initialize` — this was TD-116, reproduced
      and now resolved by this pin. See "WP16.5B Linux Launch Spike
      Report.md" for the reproduction and verification evidence.
    -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="PDFtoImage" Version="4.1.1" />
    <!--
      The Tempest Engineering Design System's prose face (Inter) ships in
      this official Avalonia package; Chakra Petch and Space Mono are
      embedded below under their own OFL licences (Assets/Fonts/OFL-*.txt)
      - recovered from the Companion brand alignment (WP 14.1A).
    -->
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <PropertyGroup>
    <!-- The TempestOS mark as the executable's own icon (Windows shell, taskbar, Alt-Tab). -->
    <ApplicationIcon>Assets\Brand\tempestos.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tempest.App\Tempest.App.csproj" />
  </ItemGroup>

</Project>
