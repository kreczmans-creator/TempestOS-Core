<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      WP 10.0B: this platform's first-ever GUI framework dependency
      (ADR-0094). No .axaml markup files are used anywhere in this project —
      every View is constructed directly in C#, a deliberate, disclosed
      choice (see WP10.0B Implementation Report.md) that keeps this Work
      Package's own first Avalonia integration on one build pipeline
      (the ordinary C# compiler) rather than two (C# plus Avalonia's own
      separate XAML compiler), while remaining fully idiomatic Avalonia —
      the framework supports pure-code UI construction as a first-class
      authoring style, not a workaround.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <!--
      Avalonia.Desktop 11.2.3 transitively pulls Tmds.DBus.Protocol 0.20.0
      (its own Linux X11/DBus clipboard integration), which carries a known
      high-severity advisory (GHSA-xrw6-gwf8-vvr9). Pinned directly to the
      latest patched release — the standard NuGet remediation for a
      vulnerable transitive dependency, disclosed here rather than
      suppressed, per WP 10.0B's own "0 Warnings" requirement.
    -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tempest.App\Tempest.App.csproj" />
  </ItemGroup>

</Project>
