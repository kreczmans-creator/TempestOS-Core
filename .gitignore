# Python
__pycache__/
*.py[cod]

# Virtual Environment
.venv/

# Logs
logs/

# Local persistence data (PersistenceStore.DefaultRootPath) - created by
# running Tempest.App locally without a configured root; a run artifact,
# never source (found and disclosed, WP 8.1A)
/persistence-data/

# Database
*.db

# VS Code
.vscode/

# OS Files
.DS_Store
Thumbs.db

# .NET build output
[Bb]in/
[Oo]bj/
out/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# .NET publish / packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Rider / other IDEs
.idea/

# Claude Code local tooling state (worktrees created for isolated background
# agents, session-local config) - ephemeral, machine-local, never source
.claude/

# MSBuild / test results
TestResults/
*.trx

# CI build logs (WP 11.1A) - written to the repository root by
# .github/workflows/ci.yml's own Build step; harmless if reproduced
# locally with the identical command, never source
build-*.log