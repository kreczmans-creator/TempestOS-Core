# Python
__pycache__/
*.py[cod]

# Virtual Environment
.venv/

# Logs
logs/

# Local persistence data (PersistenceStore.DefaultRootPath) - created by
# running Tempest.App locally without a configured root; a run artifact,
# never source (found and disclosed, WP 8.1A)
/persistence-data/

# Database
*.db

# VS Code
.vscode/

# OS Files
.DS_Store
Thumbs.db

# .NET build output
[Bb]in/
[Oo]bj/
out/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# .NET publish / packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Rider / other IDEs
.idea/

# Claude Code local tooling state (worktrees created for isolated background
# agents, session-local config) - ephemeral, machine-local, never source
.claude/

# MSBuild / test results
TestResults/
*.trx

# CI build logs (WP 11.1A) - written to the repository root by
# .github/workflows/ci.yml's own Build step; harmless if reproduced
# locally with the identical command, never source
build-*.log
# WP 17.0A: run artefacts a v0.16.0 launch and a manual backup left in the
# repository root - never source
/main.log
/persistence-data.bak/

# WP 21.5A: scripts/package-installer.ps1's own local output (the
# self-contained publish folder and the packaged installer/update-feed
# assets) and, when the `vpk` CLI is not already on PATH, the local dotnet
# tool install it falls back to - all run artefacts, never source.
/artifacts/
/.tools/

# graphify knowledge graph (see CLAUDE.md): raw graph ships as graph.json.zip,
# the AST cache is regenerable, and the interpreter/root sidecars are machine-specific
/graphify-out/graph.json
/graphify-out/cache/ast/
/graphify-out/.graphify_python
/graphify-out/.graphify_root
